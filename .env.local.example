# PlaceUp local-only runtime. Copy to .env.local; start_local.ps1 generates the
# marked secrets automatically. Do not add real API keys unless you deliberately
# want a local worker to call that external provider.

LOCAL_POSTGRES_PASSWORD=placeup_local_dev
JWT_SECRET=__GENERATE__
INTERNAL_API_KEY=__GENERATE__
SERVICE_TOKEN_SECRET=__GENERATE__
OPENCLAW_TAILOR_TOKEN=__GENERATE__
ATS_MODEL_SERVICE_TOKEN=__GENERATE__

ADMIN_EMAILS=operations@placeupcareer.com
LOCAL_TIMEZONE=America/Chicago
LOCAL_WORKER_CONCURRENCY=2
LOCAL_SCHEDULER_DISABLED_JOBS=
LOCAL_AI_ENABLED=false
LOCAL_ATS_ANALYSIS_ENABLED=false

# Local Ollama model used by the isolated OpenClaw tailor.
OLLAMA_MODEL=qwen2.5:7b

# Optional direct-source credentials. Empty values simply disable those
# providers; public ATS boards continue to work.
USAJOBS_API_KEY=
USAJOBS_EMAIL=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GREENHOUSE_BOARD_TOKENS=
HUNTER_API_KEY=

# Local scraper resource bounds. Increase only after observing your machine.
SCRAPE_MAX_CONCURRENCY=8
SCRAPER_RUN_BUDGET_SECONDS=10800

# Optional heavyweight Hugging Face ATS model. CPU mode needs substantial RAM;
# NVIDIA users can add the Docker GPU override documented in LOCAL_RUN.md.
ATS_DEVICE=auto
ATS_LOAD_IN_4BIT=true
