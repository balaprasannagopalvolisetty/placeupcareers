          "surface": "#FFFFFF",
          "surface-neutral": "rgba(22,51,0,0.078)",
          "surface-mint": "#C6ECDB",
          "surface-band": "#9FE870",
          "on-surface": "#0E0F0C",
          "on-surface-secondary": "#454745",
