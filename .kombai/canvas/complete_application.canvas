      "html": "\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"0\">\n<style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    body {\n        margin: 0;\n        padding: 0;\n        background-color: #fcfcfc;\n        color: #050505;\n        font-family: 'Inter', sans-serif;\n        letter-spacing: -0.1px;\n        overflow-x: clip;\n        -webkit-font-smoothing: antialiased;\n    }\n\n    .aura-gradient {\n        background: radial-gradient(circle at center, #ff6a3d 0%, transparent 70%);\n    }\n\n    /* Custom tracking for Universal Sans feel */\n    .tracking-tight-custom {\n        letter-spacing: -0.01em;\n    }\n\n    .splashboard-card-inner {\n        transition: border-color 0.5s ease, box-shadow 0.5s ease;\n    }\n\n    .splashboard-card-inner:hover {\n        box-shadow: 0 0 30px rgba(255, 94, 0, 0.12);\n        border-color: #FF5E00;\n    }\n</style>\n\n<div id=\"smooth-wrapper\" data-kid=\"2\">\n    <div id=\"smooth-content\" data-kid=\"3\">\n        \n        <div class=\"fixed inset-0 pointer-events-none z-0\" data-kid=\"4\">\n            <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-[80vw] h-[40vh] bg-[#FF5E00] opacity-[0.04] blur-[120px] rounded-full\" data-kid=\"5\"></div>\n            <div class=\"absolute bottom-0 left-1/2 -translate-x-1/2 w-[80vw] h-[40vh] bg-[#FF5E00] opacity-[0.04] blur-[120px] rounded-full\" data-kid=\"6\"></div>\n        </div>\n\n        \n        <nav class=\"fixed top-0 w-full px-8 py-6 flex justify-between items-center z-50\" data-kid=\"7\">\n            <div class=\"flex items-center gap-3\" data-kid=\"8\">\n                <svg width=\"32\" height=\"32\" viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" data-kid=\"9\">\n                    <circle cx=\"50\" cy=\"50\" r=\"48\" stroke=\"#050505\" stroke-width=\"4\" data-kid=\"10\"></circle>\n                    <line x1=\"20\" y1=\"80\" x2=\"80\" y2=\"20\" stroke=\"#050505\" stroke-width=\"4\" data-kid=\"11\"></line>\n                </svg>\n                <span class=\"font-medium text-lg tracking-tight-custom\" data-kid=\"12\">PlaceUp</span>\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"13\">\n                <div class=\"hidden md:flex items-center gap-6 mr-4\" data-kid=\"14\">\n                    <a href=\"#\" class=\"text-[#636363] text-sm font-medium hover:text-[#050505] transition-colors\" data-kid=\"15\">Career Path</a>\n                    <a href=\"#\" class=\"text-[#636363] text-sm font-medium hover:text-[#050505] transition-colors\" data-kid=\"16\">Intelligence</a>\n                </div>\n                <button class=\"text-[#636363] hover:text-[#050505] transition-colors\" data-kid=\"17\"><i class=\"ti ti-settings text-xl\" data-kid=\"18\"></i></button>\n                <button class=\"px-5 py-2 rounded-full border border-[oklch(0.1157_0_none_/_0.06)] text-sm font-medium hover:bg-[#f4f4f3] transition-colors\" data-kid=\"19\">Sign in</button>\n                <button class=\"px-5 py-2 rounded-full bg-[#050505] text-[#fcfcfc] text-sm font-medium hover:bg-black/90 transition-colors\" data-kid=\"20\">Sign up</button>\n            </div>\n        </nav>\n\n        \n        <header class=\"relative min-h-screen flex flex-col items-center justify-center px-6 z-10\" data-kid=\"21\">\n            <div class=\"text-center max-w-2xl w-full\" data-kid=\"22\">\n                <h1 class=\"text-6xl md:text-7xl font-medium mb-16 tracking-tighter leading-[1.05]\" data-kid=\"23\">\n                    Your career,<br data-kid=\"24\">unzipped.\n                </h1>\n\n                \n                <div id=\"dropzone-container\" class=\"relative group cursor-pointer\" data-kid=\"25\">\n                    \n                    <div id=\"hero-aura\" class=\"absolute inset-0 bg-[#FF5E00] blur-[70px] opacity-0 scale-90 rounded-full pointer-events-none\" data-kid=\"26\"></div>\n                    \n                    <div class=\"relative bg-[#f4f4f3] rounded-full px-12 py-10 border border-transparent transition-all duration-500 flex flex-col items-center gap-6\" data-kid=\"27\">\n                        <div class=\"w-16 h-16 rounded-full bg-[#050505] flex items-center justify-center text-[#fcfcfc] shadow-xl group-hover:scale-105 transition-transform duration-500\" data-kid=\"28\">\n                            <i class=\"ti ti-plus text-3xl\" data-kid=\"29\"></i>\n                        </div>\n                        <div class=\"text-center space-y-1\" data-kid=\"30\">\n                            <p class=\"text-[#050505] text-lg font-medium\" data-kid=\"31\">Upload your resume to start</p>\n                            <p class=\"text-[#636363] text-sm\" data-kid=\"32\">Drag and drop PDF, DOCX or TXT files here</p>\n                        </div>\n                        \n                        \n                        <div class=\"w-full mt-6 flex items-center justify-between border-t border-[oklch(0.1157_0_none_/_0.06)] pt-6\" data-kid=\"33\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"34\">\n                                <span class=\"text-[#636363] text-xs font-medium uppercase tracking-widest\" data-kid=\"35\">Parser</span>\n                                <div class=\"bg-[#f1f1f0] px-4 py-1.5 rounded-full text-sm font-medium flex items-center gap-2 border border-[oklch(0.1157_0_none_/_0.1)] hover:bg-[#e8e8e7] transition-colors\" data-kid=\"36\">\n                                    ATS Engine v4 <i class=\"ti ti-chevron-down text-xs\" data-kid=\"37\"></i>\n                                </div>\n                            </div>\n                            <div class=\"flex items-center gap-4\" data-kid=\"38\">\n                                <i class=\"ti ti-microphone text-[#636363] text-xl hover:text-[#050505] transition-colors\" data-kid=\"39\"></i>\n                                <div class=\"w-10 h-10 rounded-full bg-[#050505] flex items-center justify-center text-[#fcfcfc] cursor-pointer hover:scale-105 transition-transform\" data-kid=\"40\">\n                                    <i class=\"ti ti-wave-sine\" data-kid=\"41\"></i>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                \n                <p class=\"mt-12 text-[#636363] text-sm flex items-center justify-center gap-2\" data-kid=\"42\">\n                    <i class=\"ti ti-shield-check text-base\" data-kid=\"43\"></i>\n                    GDPR Compliant • Data encrypted at rest\n                </p>\n            </div>\n        </header>\n\n        \n        <section id=\"zipper-section\" class=\"py-32 relative\" data-kid=\"44\">\n            <div class=\"container mx-auto px-6\" data-kid=\"45\">\n                <h2 class=\"text-center text-4xl md:text-5xl font-medium mb-24 tracking-tight-custom\" data-kid=\"46\">The Unzipping Process</h2>\n                \n                <div class=\"relative max-w-4xl mx-auto min-h-[100vh]\" data-kid=\"47\">\n                    \n                    <div id=\"zipper-main\" class=\"absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-[1px] bg-[oklch(0.1157_0_none_/_0.12)]\" data-kid=\"48\"></div>\n                    \n                    <div id=\"zipper-guide-left\" class=\"absolute left-1/2 top-0 bottom-0 w-1/2 border-r border-[#FF5E00] opacity-0\" data-kid=\"49\"></div>\n                    <div id=\"zipper-guide-right\" class=\"absolute left-1/2 top-0 bottom-0 w-1/2 border-l border-[#FF5E00] opacity-0\" data-kid=\"50\"></div>\n\n                    \n                    <div class=\"relative z-10 flex flex-col gap-48 pt-8\" data-kid=\"51\">\n                        \n                        <div class=\"zipper-step flex flex-row items-center gap-6\" data-kid=\"52\">\n                            <div class=\"w-1/2 text-right pr-8\" data-kid=\"53\">\n                                <span class=\"inline-block text-[10px] font-bold text-[#FF5E00] mb-2 uppercase tracking-[0.3em]\" data-kid=\"54\">01</span>\n                                <h3 class=\"text-2xl font-medium mb-2\" data-kid=\"55\">Semantic Extraction</h3>\n                                <p class=\"text-[#636363] text-sm leading-relaxed max-w-[280px] ml-auto\" data-kid=\"56\">Parsing your experience with Grok-derived intelligence.</p>\n                            </div>\n                            <div class=\"w-1/2 pl-8 flex items-center\" data-kid=\"57\">\n                                <i class=\"ti ti-file-text-ai text-2xl text-[#050505]\" data-kid=\"58\"></i>\n                            </div>\n                        </div>\n\n                        \n                        <div class=\"zipper-step flex flex-row items-center gap-6\" data-kid=\"59\">\n                            <div class=\"w-1/2 text-right pr-8 flex items-center justify-end\" data-kid=\"60\">\n                                <i class=\"ti ti-world text-2xl text-[#050505]\" data-kid=\"61\"></i>\n                            </div>\n                            <div class=\"w-1/2 pl-8\" data-kid=\"62\">\n                                <span class=\"inline-block text-[10px] font-bold text-[#FF5E00] mb-2 uppercase tracking-[0.3em]\" data-kid=\"63\">02</span>\n                                <h3 class=\"text-2xl font-medium mb-2\" data-kid=\"64\">Visa Radar</h3>\n                                <p class=\"text-[#636363] text-sm leading-relaxed max-w-[280px]\" data-kid=\"65\">Cross-referenced sponsorship history across 40+ countries.</p>\n                            </div>\n                        </div>\n\n                        \n                        <div class=\"zipper-step flex flex-row items-center gap-6 pb-24\" data-kid=\"66\">\n                            <div class=\"w-1/2 text-right pr-8\" data-kid=\"67\">\n                                <span class=\"inline-block text-[10px] font-bold text-[#FF5E00] mb-2 uppercase tracking-[0.3em]\" data-kid=\"68\">03</span>\n                                <h3 class=\"text-2xl font-medium mb-2\" data-kid=\"69\">Hyper-Match</h3>\n                                <p class=\"text-[#636363] text-sm leading-relaxed max-w-[280px] ml-auto\" data-kid=\"70\">Direct pipeline to verified hiring managers.</p>\n                            </div>\n                            <div class=\"w-1/2 pl-8 flex items-center\" data-kid=\"71\">\n                                <i class=\"ti ti-bolt text-2xl text-[#FF5E00]\" data-kid=\"72\"></i>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-40 bg-white\" data-kid=\"73\">\n            <div class=\"container mx-auto px-6\" data-kid=\"74\">\n                <div class=\"max-w-3xl mb-24\" data-kid=\"75\">\n                    <h2 class=\"text-4xl font-medium mb-6 tracking-tight-custom\" data-kid=\"76\">Intelligence at every edge.</h2>\n                    <p class=\"text-[#636363] text-xl\" data-kid=\"77\">A full-stack career infrastructure designed for modern growth.</p>\n                </div>\n\n                \n                <div class=\"columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6\" data-kid=\"78\">\n                    \n                    <div class=\"splashboard-card break-inside-avoid\" data-kid=\"79\">\n                        <div class=\"splashboard-card-inner border border-[oklch(0.1157_0_none_/_0.08)] p-10 rounded-[32px] bg-white relative overflow-hidden group\" data-kid=\"80\">\n                            <div class=\"w-12 h-12 mb-8 flex items-center justify-center text-2xl text-[#050505] group-hover:text-[#FF5E00] transition-colors\" data-kid=\"81\">\n                                <i class=\"ti ti-activity-heartbeat\" data-kid=\"82\"></i>\n                            </div>\n                            <h4 class=\"text-2xl font-medium mb-4\" data-kid=\"83\">ATS Pulse</h4>\n                            <p class=\"text-[#636363] leading-relaxed text-sm\" data-kid=\"84\">Instantly see how systems parse your profile. Identify missing keywords and formatting traps.</p>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"splashboard-card break-inside-avoid\" data-kid=\"85\">\n                        <div class=\"splashboard-card-inner border border-[oklch(0.1157_0_none_/_0.08)] p-10 rounded-[32px] bg-white relative overflow-hidden group\" data-kid=\"86\">\n                            <div class=\"w-12 h-12 mb-8 flex items-center justify-center text-2xl text-[#050505] group-hover:text-[#FF5E00] transition-colors\" data-kid=\"87\">\n                                <i class=\"ti ti-globe\" data-kid=\"88\"></i>\n                            </div>\n                            <h4 class=\"text-2xl font-medium mb-4\" data-kid=\"89\">Visa Tracker</h4>\n                            <p class=\"text-[#636363] leading-relaxed text-sm mb-6\" data-kid=\"90\">Proprietary sponsorship data across UK, EU, and US markets.</p>\n                            <div class=\"flex flex-wrap gap-2\" data-kid=\"91\">\n                                <span class=\"px-3 py-1 bg-[#f4f4f3] rounded-full text-[10px] font-bold uppercase tracking-wider\" data-kid=\"92\">Tier 2</span>\n                                <span class=\"px-3 py-1 bg-[#f4f4f3] rounded-full text-[10px] font-bold uppercase tracking-wider\" data-kid=\"93\">H1-B</span>\n                                <span class=\"px-3 py-1 bg-[#f4f4f3] rounded-full text-[10px] font-bold uppercase tracking-wider\" data-kid=\"94\">Blue Card</span>\n                            </div>\n                            <div class=\"mt-8 pt-8 border-t border-[oklch(0.1157_0_none_/_0.06)]\" data-kid=\"95\">\n                                <div class=\"h-32 bg-linear-to-tr from-[#f4f4f3] to-white rounded-2xl flex items-center justify-center overflow-hidden\" data-kid=\"96\">\n                                    <div class=\"flex gap-1 items-end\" data-kid=\"97\">\n                                        <div class=\"w-2 h-8 bg-[#050505]/10 rounded-full\" data-kid=\"98\"></div>\n                                        <div class=\"w-2 h-16 bg-[#FF5E00]/40 rounded-full\" data-kid=\"99\"></div>\n                                        <div class=\"w-2 h-12 bg-[#050505]/10 rounded-full\" data-kid=\"100\"></div>\n                                        <div class=\"w-2 h-20 bg-[#FF5E00]/60 rounded-full\" data-kid=\"101\"></div>\n                                        <div class=\"w-2 h-14 bg-[#050505]/10 rounded-full\" data-kid=\"102\"></div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"splashboard-card break-inside-avoid\" data-kid=\"103\">\n                        <div class=\"splashboard-card-inner border border-[oklch(0.1157_0_none_/_0.08)] p-10 rounded-[32px] bg-white relative overflow-hidden group\" data-kid=\"104\">\n                            <div class=\"flex items-start justify-between mb-6\" data-kid=\"105\">\n                                <h4 class=\"text-2xl font-medium\" data-kid=\"106\">Direct Channel</h4>\n                                <i class=\"ti ti-bolt text-xl text-[#FF5E00]\" data-kid=\"107\"></i>\n                            </div>\n                            <p class=\"text-[#636363] text-sm leading-relaxed\" data-kid=\"108\">Skip the generic portals. Connect directly to internal workflows of fast-growing startups.</p>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"splashboard-card break-inside-avoid\" data-kid=\"109\">\n                        <div class=\"splashboard-card-inner border border-[oklch(0.1157_0_none_/_0.08)] p-8 rounded-[32px] bg-white relative overflow-hidden group flex items-center gap-6\" data-kid=\"110\">\n                            <div class=\"w-14 h-14 rounded-full bg-[#f4f4f3] flex shrink-0 items-center justify-center text-xl text-[#050505] group-hover:bg-[#FF5E00] group-hover:text-white transition-all\" data-kid=\"111\">\n                                <i class=\"ti ti-chart-dots\" data-kid=\"112\"></i>\n                            </div>\n                            <div data-kid=\"113\">\n                                <h4 class=\"text-lg font-medium\" data-kid=\"114\">Salary Pulse</h4>\n                                <p class=\"text-[#636363] text-xs\" data-kid=\"115\">Real-time localized market data benchmarks.</p>\n                            </div>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"splashboard-card break-inside-avoid\" data-kid=\"116\">\n                        <div class=\"splashboard-card-inner border border-[#050505] p-10 rounded-[32px] bg-[#050505] text-white relative overflow-hidden group\" data-kid=\"117\">\n                            <h4 class=\"text-2xl font-medium mb-4\" data-kid=\"118\">Recruiter POV</h4>\n                            <p class=\"text-white/60 text-sm leading-relaxed mb-6\" data-kid=\"119\">See exactly how your profile appears in Greenhouse, Lever, and Workday interfaces.</p>\n                            <div class=\"flex items-center gap-2 text-[#FF5E00] font-medium text-sm\" data-kid=\"120\">\n                                Explore View <i class=\"ti ti-arrow-right\" data-kid=\"121\"></i>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <footer class=\"py-20 bg-[#fcfcfc] border-t border-[oklch(0.1157_0_none_/_0.06)]\" data-kid=\"122\">\n            <div class=\"container mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-10\" data-kid=\"123\">\n                <div class=\"flex flex-col items-center md:items-start gap-4\" data-kid=\"124\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"125\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" data-kid=\"126\">\n                            <circle cx=\"50\" cy=\"50\" r=\"48\" stroke=\"#050505\" stroke-width=\"5\" data-kid=\"127\"></circle>\n                            <line x1=\"20\" y1=\"80\" x2=\"80\" y2=\"20\" stroke=\"#050505\" stroke-width=\"5\" data-kid=\"128\"></line>\n                        </svg>\n                        <span class=\"font-medium tracking-tight-custom\" data-kid=\"129\">PlaceUp</span>\n                    </div>\n                    <p class=\"text-[#636363] text-xs\" data-kid=\"130\">© 2024 PlaceUp Careers. All rights reserved.</p>\n                </div>\n                \n                <div class=\"flex gap-10\" data-kid=\"131\">\n                    <div class=\"flex flex-col gap-3\" data-kid=\"132\">\n                        <span class=\"text-[10px] uppercase tracking-widest font-bold text-[#050505]/40\" data-kid=\"133\">Product</span>\n                        <a href=\"#\" class=\"text-sm text-[#636363] hover:text-[#050505] transition-colors\" data-kid=\"134\">Changelog</a>\n                        <a href=\"#\" class=\"text-sm text-[#636363] hover:text-[#050505] transition-colors\" data-kid=\"135\">Intelligence</a>\n                    </div>\n                    <div class=\"flex flex-col gap-3\" data-kid=\"136\">\n                        <span class=\"text-[10px] uppercase tracking-widest font-bold text-[#050505]/40\" data-kid=\"137\">Legal</span>\n                        <a href=\"#\" class=\"text-sm text-[#636363] hover:text-[#050505] transition-colors\" data-kid=\"138\">Privacy</a>\n                        <a href=\"#\" class=\"text-sm text-[#636363] hover:text-[#050505] transition-colors\" data-kid=\"139\">Terms</a>\n                    </div>\n                </div>\n\n                <div class=\"flex items-center gap-4\" data-kid=\"140\">\n                    <a href=\"#\" class=\"w-10 h-10 rounded-full bg-[#f4f4f3] flex items-center justify-center text-[#636363] hover:text-[#050505] transition-colors\" data-kid=\"141\"><i class=\"ti ti-brand-twitter\" data-kid=\"142\"></i></a>\n                    <a href=\"#\" class=\"w-10 h-10 rounded-full bg-[#f4f4f3] flex items-center justify-center text-[#636363] hover:text-[#050505] transition-colors\" data-kid=\"143\"><i class=\"ti ti-brand-linkedin\" data-kid=\"144\"></i></a>\n                </div>\n            </div>\n        </footer>\n    </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"145\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"146\"></script>\n<script data-kid=\"147\">gsap.registerPlugin(ScrollTrigger);</script>\n<script type=\"module\" data-kid=\"148\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    import Snap from \"https://esm.sh/lenis@1/snap\"\n    \n    // Initialize Lenis for smooth scroll\n    const lenis = new Lenis({\n        lerp: 0.1,\n        wheelMultiplier: 1,\n        infinite: false,\n        gestureOrientation: 'vertical'\n    });\n    \n    function raf(time) {\n        lenis.raf(time);\n        requestAnimationFrame(raf);\n    }\n    requestAnimationFrame(raf);\n\n    // Hero Dropzone Interaction\n    const dropzone = document.getElementById('dropzone-container');\n    const heroAura = document.getElementById('hero-aura');\n\n    dropzone.addEventListener('mouseenter', () => {\n        gsap.to(heroAura, {\n            opacity: 0.35,\n            scale: 1.3,\n            duration: 0.8,\n            ease: \"expo.out\"\n        });\n    });\n\n    dropzone.addEventListener('mouseleave', () => {\n        gsap.to(heroAura, {\n            opacity: 0,\n            scale: 0.9,\n            duration: 0.6,\n            ease: \"power2.in\"\n        });\n    });\n\n    // Zipper Animation\n    const zipperMain = document.getElementById('zipper-main');\n    const guideL = document.getElementById('zipper-guide-left');\n    const guideR = document.getElementById('zipper-guide-right');\n    const steps = gsap.utils.toArray('.zipper-step');\n\n    // Main line animation\n    gsap.from(zipperMain, {\n        scrollTrigger: {\n            trigger: \"#zipper-section\",\n            start: \"top 70%\",\n            end: \"bottom 90%\",\n            scrub: true\n        },\n        scaleY: 0,\n        transformOrigin: \"top center\"\n    });\n\n    // Splitting effect\n    const zipperTimeline = gsap.timeline({\n        scrollTrigger: {\n            trigger: \"#zipper-section\",\n            start: \"top 30%\",\n            end: \"bottom 70%\",\n            scrub: 1.5\n        }\n    });\n\n    zipperTimeline.to(guideL, { opacity: 0.25, x: -80, duration: 1 }, 0);\n    zipperTimeline.to(guideR, { opacity: 0.25, x: 80, duration: 1 }, 0);\n    zipperTimeline.to(zipperMain, { opacity: 0, duration: 0.4 }, 0.4);\n\n    // Individual steps reveal\n    steps.forEach((step) => {\n        gsap.from(step, {\n            scrollTrigger: {\n                trigger: step,\n                start: \"top 90%\",\n                toggleActions: \"play none none reverse\"\n            },\n            y: 40,\n            opacity: 0,\n            duration: 1,\n            ease: \"power2.out\"\n        });\n    });\n\n    // Splashboard cards reveal\n    gsap.from(\".splashboard-card\", {\n        scrollTrigger: {\n            trigger: \".columns-1\",\n            start: \"top 85%\",\n            toggleActions: \"play none none none\"\n        },\n        y: 40,\n        opacity: 0,\n        stagger: 0.08,\n        duration: 1,\n        ease: \"power3.out\"\n    });\n</script>\n",
