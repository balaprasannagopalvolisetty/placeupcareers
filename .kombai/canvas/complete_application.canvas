      "html": "<div class=\"selection:bg-[#5266EB] selection:text-white bg-[#0A0D14] text-[#FAFAFC] font-sans antialiased min-h-screen\" data-kid=\"0\">\n    \n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');\n\n        :root {\n            --color-surface: #15151E;\n            --color-surface-deep: #0A0D14;\n            --color-surface-raised: #1D1D29;\n            --color-primary: #5266EB;\n            --color-primary-hover: #6275F2;\n            --color-on-surface: #FAFAFC;\n            --color-on-surface-secondary: #C4C6D0;\n            --color-on-surface-tertiary: #8A8C99;\n            --color-hairline: #2A2A38;\n        }\n\n        .wordmark {\n            letter-spacing: 0.4em;\n            text-transform: uppercase;\n        }\n\n        /* Enhanced Liquid Mercury */\n        .ovate-container {\n            mask-image: radial-gradient(circle, black 40%, transparent 80%);\n        }\n        .liquid-mercury {\n            filter: blur(50px) contrast(1.4);\n            opacity: 0.85;\n            mix-blend-mode: screen;\n        }\n\n        .scrollbar-hide::-webkit-scrollbar { display: none; }\n        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }\n\n        /* Premium Metallic/Holographic Foil */\n        .holographic-shine {\n            background: linear-gradient(\n                135deg,\n                rgba(255, 255, 255, 0) 0%,\n                rgba(255, 255, 255, 0.05) 25%,\n                rgba(255, 255, 255, 0.2) 50%,\n                rgba(255, 255, 255, 0.05) 75%,\n                rgba(255, 255, 255, 0) 100%\n            );\n            background-size: 300% 300%;\n            pointer-events: none;\n        }\n\n        .glass-field {\n            background: rgba(255, 255, 255, 0.06);\n            backdrop-filter: blur(24px);\n            border: 1px solid rgba(255, 255, 255, 0.16);\n        }\n\n        /* Removed transitions on GSAP targets */\n        .card-plateau, .enplane-card, .holographic-card {\n            background-color: #131826;\n            will-change: transform, opacity;\n            transition: border-color 0.4s ease, box-shadow 0.4s ease;\n        }\n        .card-plateau:hover {\n            border-color: rgba(255, 255, 255, 0.4);\n            box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.7);\n        }\n\n        .focus-underline::after {\n            content: '';\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            width: 0;\n            height: 1px;\n            background: #FAFAFC;\n            transition: width 0.6s cubic-bezier(0.19, 1, 0.22, 1);\n        }\n        .focus-underline:focus-within::after {\n            width: 100%;\n        }\n\n        .grain {\n            position: fixed;\n            top: 0; left: 0; width: 100%; height: 100%;\n            background: url(\"https://grainy-gradients.vercel.app/noise.svg\");\n            opacity: 0.05;\n            pointer-events: none;\n            z-index: 9999;\n        }\n\n        .bento-grid {\n            display: grid;\n            grid-template-columns: repeat(12, 1fr);\n            gap: 2rem;\n        }\n    </style>\n\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"2\">\n    <link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"3\">\n    \n    <div class=\"grain\" data-kid=\"4\"></div>\n\n    \n    <nav class=\"fixed top-0 left-0 w-full z-50 px-8 md:px-16 py-8 flex justify-between items-center bg-[#0A0D14]/60 backdrop-blur-md border-b border-white/5\" data-kid=\"5\">\n        <a href=\"#\" class=\"wordmark text-[18px] font-medium flex items-center gap-4\" data-kid=\"6\">\n            <div class=\"w-6 h-6 rounded-full border border-white/40 flex items-center justify-center\" data-kid=\"7\">\n                <div class=\"w-2.5 h-2.5 rounded-full bg-white shadow-[0_0_8px_rgba(255,255,255,0.8)]\" data-kid=\"8\"></div>\n            </div>\n            PLACEUP\n        </a>\n        <div class=\"hidden lg:flex gap-12 text-[13px] text-[#8A8C99] font-medium uppercase tracking-[0.2em]\" data-kid=\"9\">\n            <a href=\"#how-it-works\" class=\"hover:text-white transition-colors duration-300\" data-kid=\"10\">Strategy</a>\n            <a href=\"#features\" class=\"hover:text-white transition-colors duration-300\" data-kid=\"11\">Plateau</a>\n            <a href=\"#pricing\" class=\"hover:text-white transition-colors duration-300\" data-kid=\"12\">The Vault</a>\n            <a href=\"#\" class=\"hover:text-white transition-colors duration-300\" data-kid=\"13\">Access</a>\n        </div>\n        <div class=\"flex items-center gap-10\" data-kid=\"14\">\n            <a href=\"#\" class=\"text-[13px] font-medium hover:text-white transition-colors duration-300 text-[#8A8C99] uppercase tracking-widest\" data-kid=\"15\">Login</a>\n            <button class=\"bg-[#5266EB] hover:bg-[#6275F2] text-white px-8 py-3 rounded-full text-[13px] font-medium transition-all duration-300 shadow-xl shadow-[#5266EB]/20 uppercase tracking-widest\" data-kid=\"16\">\n                Open Account\n            </button>\n        </div>\n    </nav>\n\n    \n    <section class=\"relative min-h-screen flex items-center pt-20 px-8 md:px-20 overflow-hidden\" data-kid=\"17\">\n        \n        <div class=\"absolute right-[-10%] top-1/2 -translate-y-1/2 w-full max-w-[900px] aspect-square pointer-events-none ovate-container\" data-kid=\"18\">\n            <div class=\"liquid-mercury relative w-full h-full\" data-kid=\"19\">\n                <div class=\"blob absolute top-10 left-10 w-3/4 h-3/4 bg-[#A0A5B5] rounded-full\" data-kid=\"20\"></div>\n                <div class=\"blob absolute bottom-10 right-10 w-1/2 h-1/2 bg-[#C9A99A] rounded-full opacity-60\" data-kid=\"21\"></div>\n                <div class=\"blob absolute top-1/2 left-1/4 w-2/3 h-2/3 bg-[#B7B6CE] rounded-full opacity-70\" data-kid=\"22\"></div>\n                <div class=\"blob absolute bottom-1/4 right-1/3 w-1/2 h-1/2 bg-[#7E8A9E] rounded-full opacity-60\" data-kid=\"23\"></div>\n            </div>\n        </div>\n\n        <div class=\"relative z-10 max-w-4xl w-full\" data-kid=\"24\">\n            <div class=\"inline-flex items-center gap-4 px-6 py-2.5 bg-[#1D1D29] border border-[#2A2A38] rounded-full text-[12px] text-[#8A8C99] uppercase tracking-[0.3em] mb-12\" id=\"hero-pill\" data-kid=\"25\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-emerald-500\" data-kid=\"26\"></span>\n                Sponsorship Tracking Protocol Active\n            </div>\n            <h1 class=\"text-[60px] md:text-[92px] leading-[0.95] font-medium tracking-tight mb-10\" id=\"hero-title\" data-kid=\"27\">\n                Radically different <br data-kid=\"28\">\n                <span class=\"text-[#8A8C99]\" data-kid=\"29\">visa-aware</span> <br data-kid=\"30\">\n                job matching.\n            </h1>\n            <p class=\"text-[20px] md:text-[26px] text-[#C4C6D0] mb-14 max-w-xl leading-relaxed opacity-0\" id=\"hero-subtext\" data-kid=\"31\">\n                The career ecosystem for the global 1%. Verified sponsorship, ATS reverse-engineering, and elite concierge access.\n            </p>\n\n            \n            <div class=\"flex flex-col md:flex-row gap-8 items-start md:items-center opacity-0\" id=\"hero-cta\" data-kid=\"32\">\n                <div class=\"glass-field rounded-full p-2 flex items-center min-w-[380px] hover:border-white/50 transition-all duration-500 group/input\" data-kid=\"33\">\n                    <input type=\"email\" placeholder=\"Work email address\" class=\"bg-transparent border-none outline-none text-white w-full px-6 placeholder:text-white/40 text-[16px]\" data-kid=\"34\">\n                    <button class=\"bg-[#5266EB] hover:bg-[#6275F2] text-white px-8 py-4 rounded-full font-medium transition-all duration-300 whitespace-nowrap shadow-lg shadow-[#5266EB]/20\" data-kid=\"35\">\n                        Inquire Now\n                    </button>\n                </div>\n                <div class=\"flex -space-x-4 items-center ml-2\" data-kid=\"36\">\n                    <img src=\"https://i.pravatar.cc/100?u=1\" class=\"w-10 h-10 rounded-full border-2 border-[#0A0D14]\" alt=\"User\" data-kid=\"37\">\n                    <img src=\"https://i.pravatar.cc/100?u=2\" class=\"w-10 h-10 rounded-full border-2 border-[#0A0D14]\" alt=\"User\" data-kid=\"38\">\n                    <img src=\"https://i.pravatar.cc/100?u=3\" class=\"w-10 h-10 rounded-full border-2 border-[#0A0D14]\" alt=\"User\" data-kid=\"39\">\n                    <span class=\"ml-6 text-[13px] text-[#8A8C99] font-medium tracking-widest uppercase\" data-kid=\"40\">Elite members only</span>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"how-it-works\" class=\"py-32 px-8 md:px-20 relative bg-[#0A0D14]\" data-kid=\"41\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"42\">\n            <div class=\"flex items-end justify-between mb-24\" data-kid=\"43\">\n                <div data-kid=\"44\">\n                    <h2 class=\"text-[14px] font-mono text-[#8A8C99] mb-4 uppercase tracking-[0.5em]\" data-kid=\"45\">The Protocol</h2>\n                    <h3 class=\"text-[48px] font-medium\" data-kid=\"46\">How we enplane your career</h3>\n                </div>\n                <div class=\"hidden md:block w-32 h-[1px] bg-white/20 mb-4\" data-kid=\"47\"></div>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-1px bg-[#2A2A38]/50 border border-[#2A2A38] rounded-[32px] overflow-hidden\" data-kid=\"48\">\n                \n                <div class=\"bg-[#131826] p-12 group enplane-card\" data-kid=\"49\">\n                    <div class=\"text-[12px] font-mono text-[#8A8C99]/60 mb-8 uppercase tracking-[0.4em]\" data-kid=\"50\">GATE 01 / PROFILE SYNC</div>\n                    <i class=\"ti ti-plane-departure text-[40px] text-[#5266EB] mb-10 block opacity-60 group-hover:opacity-100 transition-opacity\" data-kid=\"51\"></i>\n                    <h4 class=\"text-[24px] font-medium mb-6\" data-kid=\"52\">Global Persona Build</h4>\n                    <p class=\"text-[#8A8C99] text-[17px] leading-relaxed\" data-kid=\"53\">We don't just import your CV. We build a high-fidelity visa-aware profile that meets international compliance standards instantly.</p>\n                </div>\n                \n                <div class=\"bg-[#131826] p-12 group enplane-card border-x border-[#2A2A38]\" data-kid=\"54\">\n                    <div class=\"text-[12px] font-mono text-[#8A8C99]/60 mb-8 uppercase tracking-[0.4em]\" data-kid=\"55\">GATE 02 / ATS BREACH</div>\n                    <i class=\"ti ti-adjustments-alt text-[40px] text-[#5266EB] mb-10 block opacity-60 group-hover:opacity-100 transition-opacity\" data-kid=\"56\"></i>\n                    <h4 class=\"text-[24px] font-medium mb-6\" data-kid=\"57\">Surgical Matching</h4>\n                    <p class=\"text-[#8A8C99] text-[17px] leading-relaxed\" data-kid=\"58\">Our matching engine bypasses generic filters, placing your profile directly into the \"Must Sponsor\" bucket for elite employers.</p>\n                </div>\n                \n                <div class=\"bg-[#131826] p-12 group enplane-card\" data-kid=\"59\">\n                    <div class=\"text-[12px] font-mono text-[#8A8C99]/60 mb-8 uppercase tracking-[0.4em]\" data-kid=\"60\">GATE 03 / CLEARANCE</div>\n                    <i class=\"ti ti-certificate text-[40px] text-[#5266EB] mb-10 block opacity-60 group-hover:opacity-100 transition-opacity\" data-kid=\"61\"></i>\n                    <h4 class=\"text-[24px] font-medium mb-6\" data-kid=\"62\">Verified Boarding</h4>\n                    <p class=\"text-[#8A8C99] text-[17px] leading-relaxed\" data-kid=\"63\">Receive interview clearance only from companies whose sponsorship validity has been verified by our legal network.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"features\" class=\"py-32 px-8 md:px-20\" data-kid=\"64\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"65\">\n            <div class=\"bento-grid\" data-kid=\"66\">\n                \n                <div class=\"col-span-12 md:col-span-8 card-plateau p-14 rounded-[40px] border-t border-t-white/30 relative overflow-hidden group\" data-kid=\"67\">\n                    <div class=\"relative z-10 max-w-md\" data-kid=\"68\">\n                        <div class=\"w-14 h-14 rounded-2xl bg-[#5266EB]/10 flex items-center justify-center mb-10\" data-kid=\"69\">\n                            <i class=\"ti ti-shield-check text-3xl text-[#5266EB]\" data-kid=\"70\"></i>\n                        </div>\n                        <h3 class=\"text-[36px] font-medium mb-6\" data-kid=\"71\">Radical Visa Forecasting</h3>\n                        <p class=\"text-[#C4C6D0] text-[20px] leading-relaxed\" data-kid=\"72\">Predictive analytics for global immigration. Know your chances in 45+ jurisdictions before you even consider a move.</p>\n                    </div>\n                    <div class=\"absolute right-[-10%] bottom-[-10%] w-[350px] aspect-square bg-[#A0A5B5]/5 rounded-full blur-[60px] group-hover:bg-[#A0A5B5]/10 transition-colors duration-1000\" data-kid=\"73\"></div>\n                </div>\n                \n                \n                <div class=\"col-span-12 md:col-span-4 card-plateau p-10 rounded-[40px] border-t border-t-white/30 flex flex-col justify-between\" data-kid=\"74\">\n                    <h3 class=\"text-[14px] font-medium text-[#8A8C99] uppercase tracking-widest\" data-kid=\"75\">Global Reach</h3>\n                    <div data-kid=\"76\">\n                        <div class=\"text-[60px] font-medium leading-none mb-2\" data-kid=\"77\">98%</div>\n                        <p class=\"text-[#8A8C99] text-[15px]\" data-kid=\"78\">Interview conversion rate for Elite members.</p>\n                    </div>\n                </div>\n\n                \n                <div class=\"col-span-12 md:col-span-4 card-plateau p-10 rounded-[40px] border-t border-t-white/30\" data-kid=\"79\">\n                    <div class=\"w-12 h-12 rounded-xl bg-white/5 flex items-center justify-center mb-8\" data-kid=\"80\">\n                        <i class=\"ti ti-link text-2xl text-white\" data-kid=\"81\"></i>\n                    </div>\n                    <h4 class=\"text-[22px] font-medium mb-4\" data-kid=\"82\">Concierge Bridge</h4>\n                    <p class=\"text-[#8A8C99] text-[16px] leading-relaxed\" data-kid=\"83\">Direct Slack/Signal lines to global heads of talent.</p>\n                </div>\n\n                \n                <div class=\"col-span-12 md:col-span-8 card-plateau p-10 rounded-[40px] border-t border-t-white/30 group relative overflow-hidden\" data-kid=\"84\">\n                    <div class=\"flex items-center gap-10\" data-kid=\"85\">\n                        <div class=\"flex-1\" data-kid=\"86\">\n                            <h4 class=\"text-[22px] font-medium mb-4\" data-kid=\"87\">ATS Reverse-Engineering</h4>\n                            <p class=\"text-[#8A8C99] text-[16px] leading-relaxed\" data-kid=\"88\">We update our algorithms weekly based on direct data from Greenhouse, Lever, and Workday enterprise layers.</p>\n                        </div>\n                        <div class=\"hidden md:block w-[1px] h-20 bg-[#2A2A38]\" data-kid=\"89\"></div>\n                        <div class=\"hidden md:flex flex-col items-center\" data-kid=\"90\">\n                            <span class=\"text-[24px] font-mono text-white/40\" data-kid=\"91\">G.08</span>\n                            <span class=\"text-[10px] text-[#8A8C99] uppercase tracking-widest\" data-kid=\"92\">Protocol</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"pricing\" class=\"py-32 px-8 md:px-20 bg-[#0A0D14]\" data-kid=\"93\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"94\">\n            <div class=\"text-center mb-24\" data-kid=\"95\">\n                <h2 class=\"text-[14px] font-mono text-[#8A8C99] mb-4 uppercase tracking-[0.5em]\" data-kid=\"96\">The Vault</h2>\n                <h3 class=\"text-[48px] font-medium\" data-kid=\"97\">Select your entry tier</h3>\n            </div>\n\n            <div class=\"flex flex-col lg:flex-row gap-10 items-center justify-center\" data-kid=\"98\">\n                \n                <div class=\"holographic-card relative group p-10 bg-[#15151E] border border-white/10 rounded-[32px] overflow-hidden aspect-[1.58/1] w-full max-w-[440px] flex flex-col justify-between cursor-pointer\" data-kid=\"99\">\n                    <div class=\"absolute inset-0 holographic-shine opacity-0 group-hover:opacity-100\" data-kid=\"100\"></div>\n                    <div class=\"relative z-10 flex justify-between items-start\" data-kid=\"101\">\n                        <div class=\"text-[14px] font-medium tracking-[0.4em] uppercase text-white/40\" data-kid=\"102\">CORE</div>\n                        <div class=\"w-16 h-10 bg-white/5 rounded-xl border border-white/10 flex items-center justify-center relative overflow-hidden\" data-kid=\"103\">\n                            <div class=\"absolute inset-0 bg-gradient-to-br from-white/10 to-transparent\" data-kid=\"104\"></div>\n                            <div class=\"w-10 h-6 bg-white/10 rounded-[4px] border border-white/10\" data-kid=\"105\"></div>\n                        </div>\n                    </div>\n                    <div class=\"relative z-10\" data-kid=\"106\">\n                        <div class=\"text-[36px] font-medium mb-2\" data-kid=\"107\">$0<span class=\"text-lg text-white/40\" data-kid=\"108\">/mo</span></div>\n                        <p class=\"text-[11px] font-mono tracking-[0.3em] text-white/30 uppercase\" data-kid=\"109\">Visa Awareness Tier</p>\n                    </div>\n                </div>\n\n                \n                <div class=\"holographic-card relative group p-10 bg-[#1A1A26] border border-[#5266EB]/30 rounded-[32px] overflow-hidden aspect-[1.58/1] w-full max-w-[480px] flex flex-col justify-between cursor-pointer z-20 shadow-2xl shadow-[#5266EB]/10\" data-kid=\"110\">\n                    <div class=\"absolute inset-0 holographic-shine opacity-0 group-hover:opacity-100\" data-kid=\"111\"></div>\n                    <div class=\"absolute -top-16 -right-16 w-56 h-56 bg-[#5266EB]/10 blur-[100px] rounded-full\" data-kid=\"112\"></div>\n                    <div class=\"relative z-10 flex justify-between items-start\" data-kid=\"113\">\n                        <div class=\"text-[14px] font-medium tracking-[0.4em] uppercase text-white\" data-kid=\"114\">ELITE</div>\n                        <div class=\"w-16 h-10 bg-gradient-to-br from-[#A0A5B5] via-[#FAFAFC] to-[#6E768F] rounded-xl shadow-2xl shadow-white/10 flex items-center justify-center overflow-hidden\" data-kid=\"115\">\n                            <div class=\"w-10 h-6 bg-white/20 rounded-[4px] border border-white/40\" data-kid=\"116\"></div>\n                        </div>\n                    </div>\n                    <div class=\"relative z-10\" data-kid=\"117\">\n                        <div class=\"text-[36px] font-medium mb-2 text-white\" data-kid=\"118\">$49<span class=\"text-lg text-white/40\" data-kid=\"119\">/mo</span></div>\n                        <p class=\"text-[11px] font-mono tracking-[0.3em] text-[#5266EB] font-bold uppercase\" data-kid=\"120\">Priority Sponsorship Access</p>\n                    </div>\n                </div>\n\n                \n                <div class=\"holographic-card relative group p-10 bg-[#0F0F16] border border-white/5 rounded-[32px] overflow-hidden aspect-[1.58/1] w-full max-w-[440px] flex flex-col justify-between cursor-pointer\" data-kid=\"121\">\n                    <div class=\"absolute inset-0 holographic-shine opacity-0 group-hover:opacity-100\" data-kid=\"122\"></div>\n                    <div class=\"relative z-10 flex justify-between items-start\" data-kid=\"123\">\n                        <div class=\"text-[14px] font-medium tracking-[0.4em] uppercase text-white/30\" data-kid=\"124\">PLATINUM</div>\n                        <div class=\"w-16 h-10 bg-[#2A2A38] rounded-xl border border-white/5 flex items-center justify-center relative overflow-hidden\" data-kid=\"125\">\n                             <div class=\"w-10 h-6 bg-black/40 rounded-[4px] border border-white/10\" data-kid=\"126\"></div>\n                        </div>\n                    </div>\n                    <div class=\"relative z-10\" data-kid=\"127\">\n                        <div class=\"text-[36px] font-medium mb-2\" data-kid=\"128\">$199<span class=\"text-lg text-white/40\" data-kid=\"129\">/mo</span></div>\n                        <p class=\"text-[11px] font-mono tracking-[0.3em] text-white/20 uppercase\" data-kid=\"130\">Private Legal Counsel</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-32 px-8 md:px-20 relative bg-[#0A0D14]\" data-kid=\"131\">\n        <div class=\"max-w-7xl mx-auto flex flex-col lg:flex-row gap-24 items-start\" data-kid=\"132\">\n            <div class=\"lg:sticky lg:top-40 max-w-md\" data-kid=\"133\">\n                <h2 class=\"text-[48px] font-medium mb-8\" data-kid=\"134\">Begin your <br data-kid=\"135\"> global entry.</h2>\n                <p class=\"text-[#8A8C99] text-[20px] leading-relaxed mb-10\" data-kid=\"136\">Our advisors respond within 24 business hours to qualified inquiries.</p>\n                <div class=\"flex items-center gap-6 p-6 bg-[#131826] border border-[#2A2A38] rounded-2xl\" data-kid=\"137\">\n                    <div class=\"w-12 h-12 rounded-full bg-emerald-500/10 flex items-center justify-center\" data-kid=\"138\">\n                        <i class=\"ti ti-headset text-xl text-emerald-500\" data-kid=\"139\"></i>\n                    </div>\n                    <div data-kid=\"140\">\n                        <div class=\"text-[14px] text-white font-medium uppercase tracking-widest\" data-kid=\"141\">Live Support</div>\n                        <div class=\"text-[12px] text-[#8A8C99]\" data-kid=\"142\">Available for Elite members</div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"flex-1 w-full space-y-16\" data-kid=\"143\">\n                <div class=\"relative focus-underline\" data-kid=\"144\">\n                    <label class=\"text-[11px] uppercase tracking-[0.4em] text-white/50 mb-4 block\" data-kid=\"145\">Full Name</label>\n                    <input type=\"text\" placeholder=\"Johnathan Doe\" class=\"w-full bg-transparent py-4 outline-none text-2xl text-white placeholder:text-white/10 font-medium\" data-kid=\"146\">\n                </div>\n                <div class=\"relative focus-underline\" data-kid=\"147\">\n                    <label class=\"text-[11px] uppercase tracking-[0.4em] text-white/50 mb-4 block\" data-kid=\"148\">Corporate Email</label>\n                    <input type=\"email\" placeholder=\"john@company.com\" class=\"w-full bg-transparent py-4 outline-none text-2xl text-white placeholder:text-white/10 font-medium\" data-kid=\"149\">\n                </div>\n                <div class=\"relative focus-underline\" data-kid=\"150\">\n                    <label class=\"text-[11px] uppercase tracking-[0.4em] text-white/50 mb-4 block\" data-kid=\"151\">Target Jurisdictions</label>\n                    <input type=\"text\" placeholder=\"UK, USA, Germany...\" class=\"w-full bg-transparent py-4 outline-none text-2xl text-white placeholder:text-white/10 font-medium\" data-kid=\"152\">\n                </div>\n                <div class=\"relative focus-underline\" data-kid=\"153\">\n                    <label class=\"text-[11px] uppercase tracking-[0.4em] text-white/50 mb-4 block\" data-kid=\"154\">Career Mission</label>\n                    <textarea placeholder=\"Describe your global goals...\" class=\"w-full bg-transparent py-4 outline-none text-2xl text-white placeholder:text-white/10 h-32 resize-none font-medium\" data-kid=\"155\"></textarea>\n                </div>\n                <button class=\"w-full bg-white text-[#0A0D14] py-7 rounded-full font-medium text-xl hover:bg-white/90 transition-all duration-300 uppercase tracking-widest\" data-kid=\"156\">\n                    Submit Inquiry\n                </button>\n            </div>\n        </div>\n    </section>\n\n    \n    <footer class=\"py-24 px-8 md:px-20 border-t border-[#2A2A38]\" data-kid=\"157\">\n        <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-20\" data-kid=\"158\">\n            <div data-kid=\"159\">\n                <a href=\"#\" class=\"wordmark text-[24px] font-medium flex items-center gap-4 mb-10\" data-kid=\"160\">\n                    <div class=\"w-7 h-7 rounded-full border border-white/30 flex items-center justify-center\" data-kid=\"161\">\n                        <div class=\"w-3 h-3 rounded-full bg-white\" data-kid=\"162\"></div>\n                    </div>\n                    PLACEUP\n                </a>\n                <p class=\"text-[#8A8C99] text-[16px] leading-relaxed max-w-xs\" data-kid=\"163\">Radically different job matching for the global elite. Not a job board. A banking-grade career engine.</p>\n            </div>\n            \n            <div class=\"grid grid-cols-2 lg:grid-cols-3 gap-24\" data-kid=\"164\">\n                <div class=\"space-y-6\" data-kid=\"165\">\n                    <h4 class=\"text-white font-medium uppercase text-[11px] tracking-[0.4em]\" data-kid=\"166\">Strategy</h4>\n                    <a href=\"#\" class=\"block text-[#8A8C99] hover:text-white transition-colors text-sm\" data-kid=\"167\">Onboarding</a>\n                    <a href=\"#\" class=\"block text-[#8A8C99] hover:text-white transition-colors text-sm\" data-kid=\"168\">ATS Protocol</a>\n                    <a href=\"#\" class=\"block text-[#8A8C99] hover:text-white transition-colors text-sm\" data-kid=\"169\">Legal Clearing</a>\n                </div>\n                <div class=\"space-y-6\" data-kid=\"170\">\n                    <h4 class=\"text-white font-medium uppercase text-[11px] tracking-[0.4em]\" data-kid=\"171\">Membership</h4>\n                    <a href=\"#\" class=\"block text-[#8A8C99] hover:text-white transition-colors text-sm\" data-kid=\"172\">The Vault</a>\n                    <a href=\"#\" class=\"block text-[#8A8C99] hover:text-white transition-colors text-sm\" data-kid=\"173\">Concierge</a>\n                    <a href=\"#\" class=\"block text-[#8A8C99] hover:text-white transition-colors text-sm\" data-kid=\"174\">Resources</a>\n                </div>\n                <div class=\"space-y-6\" data-kid=\"175\">\n                    <h4 class=\"text-white font-medium uppercase text-[11px] tracking-[0.4em]\" data-kid=\"176\">Connect</h4>\n                    <a href=\"#\" class=\"block text-[#8A8C99] hover:text-white transition-colors text-sm\" data-kid=\"177\">LinkedIn</a>\n                    <a href=\"#\" class=\"block text-[#8A8C99] hover:text-white transition-colors text-sm\" data-kid=\"178\">Twitter</a>\n                    <a href=\"#\" class=\"block text-[#8A8C99] hover:text-white transition-colors text-sm\" data-kid=\"179\">Signal</a>\n                </div>\n            </div>\n        </div>\n        <div class=\"max-w-7xl mx-auto mt-24 pt-10 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"180\">\n            <p class=\"text-[11px] text-[#8A8C99] uppercase tracking-[0.3em]\" data-kid=\"181\">© 2026 PlaceUp Global Protocol. All Rights Reserved.</p>\n            <div class=\"flex gap-12 text-[11px] text-[#8A8C99] uppercase tracking-[0.4em]\" data-kid=\"182\">\n                <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"183\">Privacy</a>\n                <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"184\">Legal</a>\n                <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"185\">Status</a>\n            </div>\n        </div>\n    </footer>\n\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"186\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"187\"></script>\n    <script type=\"module\" data-kid=\"188\">\n        import Lenis from \"https://esm.sh/lenis@1\"\n        const lenis = new Lenis();\n        function raf(time) {\n            lenis.raf(time);\n            requestAnimationFrame(raf);\n        }\n        requestAnimationFrame(raf);\n        \n        gsap.registerPlugin(ScrollTrigger);\n\n        // Hero Entrance\n        const tl = gsap.timeline();\n        tl.from(\"#hero-title\", { y: 80, opacity: 0, duration: 1.6, ease: \"expo.out\" })\n          .to(\"#hero-subtext\", { opacity: 1, y: 0, duration: 1.2, ease: \"power3.out\" }, \"-=1.2\")\n          .to(\"#hero-cta\", { opacity: 1, y: 0, duration: 1.2, ease: \"power3.out\" }, \"-=1\");\n\n        // Liquid Mercury Animation (Higher intensity)\n        gsap.to(\".blob\", {\n            x: \"random(-200, 200)\",\n            y: \"random(-200, 200)\",\n            duration: \"random(8, 16)\",\n            repeat: -1,\n            yoyo: true,\n            ease: \"sine.inOut\",\n            stagger: { amount: 6, from: \"random\" }\n        });\n\n        // Scroll Reveals (No CSS transitions on these)\n        const revealTargets = ['.enplane-card', '.card-plateau', '.holographic-card', 'h2', 'h3'];\n        revealTargets.forEach(target => {\n            gsap.utils.toArray(target).forEach(el => {\n                gsap.from(el, {\n                    scrollTrigger: {\n                        trigger: el,\n                        start: \"top 85%\",\n                        toggleActions: \"play none none none\"\n                    },\n                    y: 60,\n                    opacity: 0,\n                    duration: 1.2,\n                    ease: \"power3.out\"\n                });\n            });\n        });\n\n        // Holographic Tilt & Shine (No CSS transitions)\n        document.querySelectorAll('.holographic-card').forEach(card => {\n            const shine = card.querySelector('.holographic-shine');\n            card.addEventListener('mousemove', e => {\n                const rect = card.getBoundingClientRect();\n                const x = e.clientX - rect.left;\n                const y = e.clientY - rect.top;\n                const px = (x / rect.width) * 100;\n                const py = (y / rect.height) * 100;\n                \n                gsap.to(shine, { backgroundPosition: `${px}% ${py}%`, duration: 0.3 });\n                const rotateY = ((x - rect.width/2) / rect.width) * 12;\n                const rotateX = -((y - rect.height/2) / rect.height) * 12;\n                gsap.to(card, { rotateY, rotateX, scale: 1.02, duration: 0.5, ease: \"power2.out\" });\n            });\n\n            card.addEventListener('mouseleave', () => {\n                gsap.to(card, { rotateY: 0, rotateX: 0, scale: 1, duration: 1, ease: \"elastic.out(1, 0.4)\" });\n            });\n        });\n    </script>\n</div>",
