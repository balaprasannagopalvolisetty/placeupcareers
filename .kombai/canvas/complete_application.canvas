      "html": "<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"0\">\n<style data-kid=\"1\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;800&family=Space+Grotesk:wght@700;800&family=JetBrains+Mono:wght@500;700&display=swap');\n\n  :root {\n    --bg: #011126;\n    --orange: #ED7D2B;\n    --red: #C75A12;\n    --cream: #F5EAC8;\n    --glass: rgba(13, 28, 53, 0.45);\n    --border: rgba(245, 234, 200, 0.1);\n  }\n\n  body {\n    background: var(--bg);\n    color: var(--cream);\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .noise {\n    position: fixed;\n    inset: 0;\n    z-index: 100;\n    pointer-events: none;\n    opacity: 0.03;\n    background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E\");\n  }\n\n  .scroller-container {\n    height: 600vh;\n    position: relative;\n  }\n\n  .viewport {\n    position: sticky;\n    top: 0;\n    height: 100vh;\n    width: 100%;\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  /* 3D Topographic Layers */\n  .topo-stage {\n    position: absolute;\n    width: 200%;\n    height: 200%;\n    top: -50%;\n    left: -50%;\n    perspective: 1200px;\n    transform-style: preserve-3d;\n  }\n\n  .topo-layer {\n    position: absolute;\n    inset: 0;\n    background-image: url(\"data:image/svg+xml,%3Csvg width='1440' height='900' viewBox='0 0 1440 900' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M-100 800 Q 200 700 400 850 T 800 700 T 1200 850 T 1600 700' fill='none' stroke='rgba(237,125,43,0.1)' stroke-width='1'/%3E%3Cpath d='M-100 600 Q 250 450 500 650 T 900 450 T 1300 650 T 1700 450' fill='none' stroke='rgba(237,125,43,0.08)' stroke-width='1'/%3E%3Cpath d='M-100 400 Q 300 200 600 450 T 1000 200 T 1400 450 T 1800 200' fill='none' stroke='rgba(237,125,43,0.06)' stroke-width='1'/%3E%3Cpath d='M-100 200 Q 350 0 700 250 T 1100 0 T 1500 250 T 1900 0' fill='none' stroke='rgba(237,125,43,0.04)' stroke-width='1'/%3E%3C/svg%3E\");\n    background-size: cover;\n    pointer-events: none;\n  }\n\n  /* Ambient Orbs */\n  .orb {\n    position: absolute;\n    border-radius: 50%;\n    filter: blur(120px);\n    opacity: 0.15;\n    z-index: 1;\n  }\n\n  /* Content Cards */\n  .story-card {\n    position: absolute;\n    padding: 32px;\n    border-radius: 24px;\n    background: var(--glass);\n    backdrop-filter: blur(24px);\n    border: 1px solid var(--border);\n    width: 380px;\n    box-shadow: 0 20px 50px rgba(0,0,0,0.3);\n    opacity: 0;\n    transform: translateY(50px) translateZ(100px);\n    z-index: 10;\n  }\n\n  .interactive-lens {\n    position: fixed;\n    width: 280px;\n    height: 280px;\n    border-radius: 50%;\n    background: radial-gradient(circle at 30% 30%, rgba(237,125,43,0.2), transparent 70%);\n    border: 1px solid rgba(237,125,43,0.3);\n    backdrop-filter: blur(8px);\n    pointer-events: none;\n    z-index: 100;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    opacity: 0;\n  }\n\n  .marker-node {\n    position: absolute;\n    z-index: 5;\n    transform-style: preserve-3d;\n  }\n\n  .badge-orange {\n    display: inline-flex;\n    padding: 6px 14px;\n    border-radius: 99px;\n    background: rgba(237, 125, 43, 0.1);\n    border: 1px solid rgba(237, 125, 43, 0.3);\n    color: var(--orange);\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.05em;\n    text-transform: uppercase;\n    margin-bottom: 16px;\n  }\n</style>\n\n<div class=\"noise\" data-kid=\"2\"></div>\n<div class=\"interactive-lens\" id=\"lens\" data-kid=\"3\">\n  <div style=\"text-align: center;\" data-kid=\"4\">\n    <div style=\"font-family: 'Space Grotesk'; font-size: 42px; font-weight: 800; color: var(--cream);\" data-kid=\"5\">94%</div>\n    <div style=\"font-size: 11px; color: var(--orange); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;\" data-kid=\"6\">ATS Breakdown</div>\n  </div>\n</div>\n\n<div class=\"scroller-container\" data-kid=\"7\">\n  <div class=\"viewport\" data-kid=\"8\">\n    \n    <div class=\"orb\" style=\"width: 600px; height: 600px; background: var(--red); top: -10%; left: -10%;\" data-kid=\"9\"></div>\n    <div class=\"orb\" style=\"width: 500px; height: 500px; background: var(--orange); bottom: -10%; right: -10%;\" data-kid=\"10\"></div>\n\n    \n    <div class=\"topo-stage\" id=\"stage\" data-kid=\"11\">\n      <div class=\"topo-layer\" style=\"transform: translateZ(-200px)\" data-kid=\"12\"></div>\n      <div class=\"topo-layer\" style=\"transform: translateZ(-100px); opacity: 0.6\" data-kid=\"13\"></div>\n      <div class=\"topo-layer\" style=\"transform: translateZ(0px); opacity: 0.4\" data-kid=\"14\"></div>\n      <div class=\"topo-layer\" style=\"transform: translateZ(100px); opacity: 0.2\" data-kid=\"15\"></div>\n\n      \n      <div class=\"marker-node\" style=\"top: 30%; left: 25%; transform: translateZ(50px)\" data-kid=\"16\">\n        <svg width=\"120\" height=\"120\" viewBox=\"0 0 120 120\" data-kid=\"17\">\n          <circle cx=\"60\" cy=\"60\" r=\"40\" fill=\"rgba(237,125,43,0.2)\" data-kid=\"18\"></circle>\n          <circle cx=\"60\" cy=\"60\" r=\"15\" fill=\"var(--orange)\" data-kid=\"19\"></circle>\n          <ellipse cx=\"60\" cy=\"60\" rx=\"55\" ry=\"15\" fill=\"none\" stroke=\"var(--orange)\" stroke-width=\"1\" opacity=\"0.4\" data-kid=\"20\"></ellipse>\n          <ellipse cx=\"60\" cy=\"60\" rx=\"15\" ry=\"55\" fill=\"none\" stroke=\"var(--orange)\" stroke-width=\"1\" opacity=\"0.4\" transform=\"rotate(45 60 60)\" data-kid=\"21\"></ellipse>\n        </svg>\n      </div>\n\n      <div class=\"marker-node\" style=\"top: 60%; left: 70%; transform: translateZ(80px)\" data-kid=\"22\">\n        <svg width=\"160\" height=\"160\" viewBox=\"0 0 160 160\" data-kid=\"23\">\n          <circle cx=\"80\" cy=\"80\" r=\"50\" fill=\"rgba(237,125,43,0.15)\" data-kid=\"24\"></circle>\n          <circle cx=\"80\" cy=\"80\" r=\"20\" fill=\"var(--orange)\" data-kid=\"25\"></circle>\n          <ellipse cx=\"80\" cy=\"80\" rx=\"75\" ry=\"25\" fill=\"none\" stroke=\"var(--orange)\" stroke-width=\"1\" opacity=\"0.5\" data-kid=\"26\"></ellipse>\n        </svg>\n      </div>\n    </div>\n\n    \n    <div class=\"story-card\" id=\"card-1\" style=\"top: 20%; left: 10%;\" data-kid=\"27\">\n      <span class=\"badge-orange\" data-kid=\"28\">Growth Trajectory</span>\n      <h2 style=\"font-family: 'Space Grotesk'; font-size: 28px; font-weight: 700; margin: 0 0 12px; color: var(--cream);\" data-kid=\"29\">The High-Growth Peaks</h2>\n      <p style=\"font-size: 14px; line-height: 1.6; color: rgba(245, 234, 200, 0.7); margin-bottom: 24px;\" data-kid=\"30\">\n        PlaceUp identifies salary \"peaks\" across 25 countries. We fly you directly to the highest compatibility roles.\n      </p>\n      <div style=\"display: flex; gap: 12px;\" data-kid=\"31\">\n        <div style=\"flex: 1; padding: 12px; border-radius: 12px; background: rgba(255,255,255,0.03); border: 1px solid var(--border);\" data-kid=\"32\">\n          <div style=\"font-family: 'JetBrains Mono'; font-size: 20px; font-weight: 700; color: var(--orange);\" data-kid=\"33\">$160k+</div>\n          <div style=\"font-size: 10px; color: rgba(245, 234, 200, 0.5); text-transform: uppercase;\" data-kid=\"34\">Avg. Salary</div>\n        </div>\n        <div style=\"flex: 1; padding: 12px; border-radius: 12px; background: rgba(255,255,255,0.03); border: 1px solid var(--border);\" data-kid=\"35\">\n          <div style=\"font-family: 'JetBrains Mono'; font-size: 20px; font-weight: 700; color: var(--orange);\" data-kid=\"36\">4.2k</div>\n          <div style=\"font-size: 10px; color: rgba(245, 234, 200, 0.5); text-transform: uppercase;\" data-kid=\"37\">Open Roles</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"story-card\" id=\"card-2\" style=\"top: 40%; right: 10%;\" data-kid=\"38\">\n      <span class=\"badge-orange\" data-kid=\"39\">Real-time Matching</span>\n      <h2 style=\"font-family: 'Space Grotesk'; font-size: 28px; font-weight: 700; margin: 0 0 12px; color: var(--cream);\" data-kid=\"40\">Interactive Lens</h2>\n      <p style=\"font-size: 14px; line-height: 1.6; color: rgba(245, 234, 200, 0.7); margin-bottom: 24px;\" data-kid=\"41\">\n        Hover over any data point to reveal the hidden ATS mechanics. We break down exactly why you're a match.\n      </p>\n      <div style=\"height: 1px; background: var(--border); margin-bottom: 16px;\" data-kid=\"42\"></div>\n      <div style=\"font-size: 12px; font-style: italic; color: var(--orange);\" data-kid=\"43\">\"Initializing deep scan of 47 new H-1B matches...\"</div>\n    </div>\n\n    \n    <div id=\"hero-text\" style=\"text-align: center; max-width: 900px; z-index: 20;\" data-kid=\"44\">\n      <h1 style=\"font-family: 'Space Grotesk'; font-size: 82px; font-weight: 800; line-height: 1.05; letter-spacing: -0.04em; color: var(--cream); margin: 0 0 24px;\" data-kid=\"45\">\n        Career <span style=\"background: linear-gradient(135deg, #F2A341, #ED7D2B, #C75A12); -webkit-background-clip: text; -webkit-text-fill-color: transparent;\" data-kid=\"46\">Topography</span>\n      </h1>\n      <p style=\"font-size: 20px; color: rgba(245, 234, 200, 0.65); max-width: 600px; margin: 0 auto;\" data-kid=\"47\">\n        Navigate the global job market as a 3D landscape of opportunity.\n      </p>\n    </div>\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"48\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"49\"></script>\n<script type=\"module\" data-kid=\"50\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  \n  gsap.registerPlugin(ScrollTrigger);\n\n  const lenis = new Lenis({ autoRaf: true });\n  lenis.on('scroll', ScrollTrigger.update);\n\n  // Intro Parallax / Camera Move\n  const tl = gsap.timeline({\n    scrollTrigger: {\n      trigger: \".scroller-container\",\n      start: \"top top\",\n      end: \"bottom bottom\",\n      scrub: 1,\n    }\n  });\n\n  tl.to(\"#hero-text\", { y: -200, opacity: 0, scale: 0.8, duration: 1 })\n    .to(\"#stage\", { \n      rotateX: 60, \n      z: 500, \n      y: -200, \n      scale: 1.2, \n      duration: 3 \n    }, 0)\n    .to(\"#card-1\", { opacity: 1, y: 0, z: 0, duration: 1 }, 1)\n    .to(\"#card-1\", { opacity: 0, y: -100, duration: 1 }, 2)\n    .to(\"#card-2\", { opacity: 1, y: 0, z: 0, duration: 1 }, 2.5)\n    .to(\"#lens\", { opacity: 1, scale: 1, duration: 1 }, 2.5);\n\n  // Mouse move for Lens and Tilt\n  document.addEventListener('mousemove', (e) => {\n    const x = e.clientX;\n    const y = e.clientY;\n    \n    gsap.to(\"#lens\", {\n      x: x - 140,\n      y: y - 140,\n      duration: 0.6,\n      ease: \"power2.out\"\n    });\n\n    const moveX = (x - window.innerWidth / 2) / 50;\n    const moveY = (y - window.innerHeight / 2) / 50;\n\n    gsap.to(\"#stage\", {\n      rotateY: moveX,\n      rotateX: 60 + moveY,\n      duration: 1,\n      ease: \"power2.out\"\n    });\n  });\n\n  // Animate the markers\n  gsap.to(\".marker-node ellipse\", {\n    rotateZ: 360,\n    duration: 10,\n    repeat: -1,\n    ease: \"none\"\n  });\n\n  gsap.to(\".marker-node circle:last-of-type\", {\n    scale: 1.2,\n    opacity: 0.6,\n    duration: 2,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\"\n  });\n\n</script>",
