      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    background-color: #15151E;\n    color: #FAFAFC;\n    margin: 0;\n    overflow-x: hidden;\n    font-family: 'Inter', sans-serif;\n  }\n\n  .glass-card {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(24px);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n  }\n\n  .electric-line {\n    background: linear-gradient(90deg, transparent, #5266EB, transparent);\n    box-shadow: 0 0 20px #5266EB;\n  }\n\n  .periwinkle-glow {\n    filter: drop-shadow(0 0 8px #5266EB);\n  }\n\n  .matrix-grid {\n    background-image: radial-gradient(circle, rgba(82, 102, 235, 0.1) 1px, transparent 1px);\n    background-size: 40px 40px;\n  }\n\n  .grain-overlay {\n    background-image: url(\"https://www.transparenttextures.com/patterns/carbon-fibre.png\");\n    opacity: 0.05;\n  }\n\n  .isometric-view {\n    transform: perspective(1000px) rotateX(45deg) rotateZ(-30deg);\n  }\n</style>\n\n<div class=\"relative min-h-screen w-full matrix-grid\" data-kid=\"1\">\n  <div class=\"absolute inset-0 grain-overlay pointer-events-none\" data-kid=\"2\"></div>\n\n  \n  <nav class=\"fixed top-0 left-0 w-full z-50 px-8 py-6 flex justify-between items-center bg-[#15151E]/80 backdrop-blur-xl border-b border-[#2A2A38]\" data-kid=\"3\">\n    <div class=\"flex items-center gap-3\" data-kid=\"4\">\n      <div class=\"w-8 h-8 rounded-full border-2 border-[#5266EB] flex items-center justify-center\" data-kid=\"5\">\n        <div class=\"w-2 h-2 bg-[#5266EB] rounded-full\" data-kid=\"6\"></div>\n      </div>\n      <span style=\"font-family: 'Space Grotesk'; fontSize: 18px; fontWeight: 500; letterSpacing: 3px;\" data-kid=\"7\">P L A C E U P</span>\n    </div>\n    <div class=\"flex items-center gap-10\" data-kid=\"8\">\n      <a href=\"#\" class=\"text-[#C4C6D0] hover:text-[#FAFAFC] transition-colors\" style=\"fontSize: 14px; fontWeight: 500;\" data-kid=\"9\">NETWORK</a>\n      <a href=\"#\" class=\"text-[#C4C6D0] hover:text-[#FAFAFC] transition-colors\" style=\"fontSize: 14px; fontWeight: 500;\" data-kid=\"10\">SYCHRONIZE</a>\n      <a href=\"#\" class=\"text-[#C4C6D0] hover:text-[#FAFAFC] transition-colors\" style=\"fontSize: 14px; fontWeight: 500;\" data-kid=\"11\">MATRIX</a>\n      <button class=\"px-6 py-2 rounded-full bg-[#5266EB] text-white hover:bg-[#6275F2] transition-all\" style=\"fontSize: 14px; fontWeight: 500;\" data-kid=\"12\">INITIALIZE</button>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative h-screen flex items-center overflow-hidden\" data-kid=\"13\">\n    \n    <div class=\"absolute inset-0 z-10 flex items-center justify-center pointer-events-none\" data-kid=\"14\">\n      <div class=\"electric-line w-[150%] h-[2px] rotate-[-25deg]\" data-kid=\"15\"></div>\n    </div>\n\n    \n    <div class=\"absolute right-0 top-0 w-1/2 h-full\" data-kid=\"16\">\n      <video src=\"https://videos.pexels.com/video-files/35002915/14828935_360_640_30fps.mp4\" poster=\"https://images.pexels.com/videos/35002915/pexels-photo-35002915.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=1200&w=630\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover opacity-60\" data-kid=\"17\">\n      </video>\n      <div class=\"absolute inset-0 bg-gradient-to-r from-[#15151E] via-transparent to-transparent\" data-kid=\"18\"></div>\n    </div>\n\n    \n    <div class=\"container mx-auto px-12 relative z-20 flex flex-col gap-8 w-1/2\" data-kid=\"19\">\n      <div class=\"stagger-panel opacity-0 translate-x-[-50px]\" data-kid=\"20\">\n        <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#5266EB]/10 border border-[#5266EB]/30 mb-6\" data-kid=\"21\">\n          <div class=\"w-1.5 h-1.5 bg-[#5266EB] rounded-full animate-pulse\" data-kid=\"22\"></div>\n          <span class=\"text-[#5266EB]\" style=\"fontSize: 12px; fontWeight: 600; letterSpacing: 1px;\" data-kid=\"23\">SYSTEM STATUS: ACTIVE</span>\n        </div>\n        <h1 id=\"hero-title\" style=\"font-family: 'Space Grotesk'; fontSize: 72px; fontWeight: 700; lineHeight: 1.1; letterSpacing: -2px;\" class=\"text-[#FAFAFC]\" data-kid=\"24\">\n          INITIALIZING <br data-kid=\"25\">\n          <span class=\"bg-gradient-to-r from-[#5266EB] to-[#FAFAFC] bg-clip-text text-transparent\" data-kid=\"26\">CAREER MATRIX</span>\n        </h1>\n        <p class=\"text-[#C4C6D0] mt-6 max-w-md\" style=\"fontSize: 18px; lineHeight: 1.6;\" data-kid=\"27\">\n          Deploying biometric placement algorithms. Reconstructing the professional landscape through high-fidelity matching nodes.\n        </p>\n      </div>\n\n      <div class=\"flex gap-4 mt-8 stagger-panel opacity-0 translate-x-[-50px]\" data-kid=\"28\">\n        <div class=\"glass-card p-6 rounded-2xl w-48 border-l-2 border-[#5266EB]\" data-kid=\"29\">\n          <span class=\"text-[#8A8C99] block mb-2\" style=\"fontSize: 12px; fontWeight: 600;\" data-kid=\"30\">ACTIVE NODES</span>\n          <span style=\"font-family: 'Space Grotesk'; fontSize: 32px; fontWeight: 700;\" data-kid=\"31\">4,021</span>\n        </div>\n        <div class=\"glass-card p-6 rounded-2xl w-48 border-l-2 border-[#5266EB]/30\" data-kid=\"32\">\n          <span class=\"text-[#8A8C99] block mb-2\" style=\"fontSize: 12px; fontWeight: 600;\" data-kid=\"33\">LINKED TALENT</span>\n          <span style=\"font-family: 'Space Grotesk'; fontSize: 32px; fontWeight: 700;\" data-kid=\"34\">12.8K</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 relative overflow-hidden bg-[#1D1D29]/30 border-y border-[#2A2A38]\" data-kid=\"35\">\n    <div class=\"container mx-auto px-12 flex items-center justify-between\" data-kid=\"36\">\n      <div class=\"w-1/2 pr-20\" data-kid=\"37\">\n        <span class=\"text-[#5266EB] block mb-4\" style=\"fontSize: 14px; fontWeight: 600; letterSpacing: 2px;\" data-kid=\"38\">ALGORITHMIC SYNC</span>\n        <h2 style=\"font-family: 'Space Grotesk'; fontSize: 48px; fontWeight: 700; lineHeight: 1.2;\" data-kid=\"39\">\n          BACK-GEARED <br data-kid=\"40\">\n          SKILL ALIGNMENT\n        </h2>\n        <p class=\"text-[#C4C6D0] mt-6\" style=\"fontSize: 18px; lineHeight: 1.6;\" data-kid=\"41\">\n          Our concentric matching mechanism rotates through thousands of industry data points, triggering a periwinkle spark only when absolute resonance is achieved.\n        </p>\n        \n        <div class=\"mt-12 space-y-6\" data-kid=\"42\">\n          <div class=\"flex items-start gap-4 p-4 glass-card rounded-xl hover:border-[#5266EB]/50 transition-colors\" data-kid=\"43\">\n            <div class=\"w-12 h-12 rounded-lg bg-[#5266EB]/10 flex items-center justify-center shrink-0\" data-kid=\"44\">\n              <i class=\"ti ti-cpu text-[#5266EB]\" style=\"fontSize: 24px;\" data-kid=\"45\"></i>\n            </div>\n            <div data-kid=\"46\">\n              <h4 style=\"fontSize: 16px; fontWeight: 600;\" data-kid=\"47\">Hardware-Level Accuracy</h4>\n              <p class=\"text-[#8A8C99] mt-1\" style=\"fontSize: 14px;\" data-kid=\"48\">Proprietary logic-gate analysis of resume structures and skill clusters.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"w-1/2 relative h-[600px] flex items-center justify-center\" data-kid=\"49\">\n        <div class=\"relative w-[500px] h-[500px]\" data-kid=\"50\">\n          \n          <div class=\"ring-outer absolute inset-0 border-[1px] border-dashed border-[#5266EB]/20 rounded-full flex items-center justify-center\" data-kid=\"51\">\n            <div class=\"absolute top-0 w-4 h-4 bg-[#5266EB] rounded-full periwinkle-glow\" data-kid=\"52\"></div>\n          </div>\n          \n          <div class=\"ring-inner absolute inset-8 border-[1px] border-[#2A2A38] rounded-full flex items-center justify-center bg-[#15151E]/10 backdrop-blur-sm\" data-kid=\"53\">\n             <div class=\"absolute bottom-10 left-10 w-3 h-3 bg-[#5266EB]/50 rounded-full\" data-kid=\"54\"></div>\n          </div>\n          \n          <div class=\"absolute inset-32 glass-card rounded-full overflow-hidden flex items-center justify-center\" data-kid=\"55\">\n            <img src=\"https://images.unsplash.com/photo-1735630455883-bca2c8da0c9a?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover opacity-80\" alt=\"Fiber Optics\" data-kid=\"56\">\n            <div class=\"absolute inset-0 bg-[#5266EB]/20 mix-blend-overlay\" data-kid=\"57\"></div>\n            <div class=\"absolute z-10 text-center\" data-kid=\"58\">\n              <span style=\"font-family: 'Space Grotesk'; fontSize: 48px; fontWeight: 700;\" data-kid=\"59\">94%</span>\n              <span class=\"block text-[#FAFAFC]\" style=\"fontSize: 12px; fontWeight: 600;\" data-kid=\"60\">MATCH SCORE</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 relative\" data-kid=\"61\">\n    <div class=\"container mx-auto px-12 text-center mb-20\" data-kid=\"62\">\n      <span class=\"text-[#5266EB] block mb-4\" style=\"fontSize: 14px; fontWeight: 600; letterSpacing: 2px;\" data-kid=\"63\">THE ELECTROLOGIST</span>\n      <h2 style=\"font-family: 'Space Grotesk'; fontSize: 48px; fontWeight: 700;\" data-kid=\"64\">STRUCTURED DATA CLUSTER</h2>\n    </div>\n\n    <div class=\"relative h-[800px] flex items-center justify-center\" data-kid=\"65\">\n       \n       <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/circuitry.svg\" class=\"absolute opacity-5 w-[1000px] pointer-events-none\" style=\"color: #5266EB;\" data-kid=\"66\">\n\n       \n       <div class=\"isometric-view grid grid-cols-3 gap-8\" data-kid=\"67\">\n          \n          <div class=\"iso-card glass-card p-8 rounded-2xl w-80 relative overflow-hidden group cursor-pointer\" data-kid=\"68\">\n            <div class=\"absolute top-0 left-0 w-full h-1 bg-[#5266EB] opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"69\"></div>\n            <div class=\"flex items-center gap-4 mb-6\" data-kid=\"70\">\n              <div class=\"w-12 h-12 rounded-xl bg-[#5266EB] flex items-center justify-center shadow-[0_0_15px_#5266EB]\" data-kid=\"71\">\n                <i class=\"ti ti-user-check text-white\" style=\"fontSize: 24px;\" data-kid=\"72\"></i>\n              </div>\n              <div data-kid=\"73\">\n                <h4 style=\"fontSize: 18px; fontWeight: 600;\" data-kid=\"74\">Alex Sterling</h4>\n                <p class=\"text-[#8A8C99]\" style=\"fontSize: 13px;\" data-kid=\"75\">Full Stack Engineer</p>\n              </div>\n            </div>\n            <div class=\"space-y-3\" data-kid=\"76\">\n              <div class=\"h-2 w-full bg-[#2A2A38] rounded-full overflow-hidden\" data-kid=\"77\">\n                <div class=\"h-full bg-[#5266EB] w-[88%]\" data-kid=\"78\"></div>\n              </div>\n              <div class=\"flex justify-between text-[#8A8C99]\" style=\"fontSize: 12px; fontWeight: 500;\" data-kid=\"79\">\n                <span data-kid=\"80\">ATS RANKING</span>\n                <span data-kid=\"81\">88%</span>\n              </div>\n            </div>\n          </div>\n\n          \n          <div class=\"iso-card glass-card p-8 rounded-2xl w-80 relative overflow-hidden group cursor-pointer mt-12\" data-kid=\"82\">\n            <div class=\"absolute top-0 left-0 w-full h-1 bg-[#5266EB] opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"83\"></div>\n            <div class=\"flex items-center gap-4 mb-6\" data-kid=\"84\">\n              <div class=\"w-12 h-12 rounded-xl bg-[#2A2A38] flex items-center justify-center\" data-kid=\"85\">\n                <i class=\"ti ti-briefcase text-[#C4C6D0]\" style=\"fontSize: 24px;\" data-kid=\"86\"></i>\n              </div>\n              <div data-kid=\"87\">\n                <h4 style=\"fontSize: 18px; fontWeight: 600;\" data-kid=\"88\">Quantum Systems</h4>\n                <p class=\"text-[#8A8C99]\" style=\"fontSize: 13px;\" data-kid=\"89\">Palo Alto, CA</p>\n              </div>\n            </div>\n            <div class=\"flex gap-2\" data-kid=\"90\">\n              <span class=\"px-2 py-1 rounded bg-[#5266EB]/10 text-[#5266EB]\" style=\"fontSize: 10px; fontWeight: 600;\" data-kid=\"91\">VISA SPONSORED</span>\n              <span class=\"px-2 py-1 rounded bg-[#1D1D29] text-[#C4C6D0]\" style=\"fontSize: 10px; fontWeight: 600;\" data-kid=\"92\">REMOTE</span>\n            </div>\n          </div>\n\n          \n          <div class=\"iso-card glass-card p-8 rounded-2xl w-80 relative overflow-hidden group cursor-pointer -mt-12\" data-kid=\"93\">\n            <div class=\"absolute top-0 left-0 w-full h-1 bg-[#5266EB] opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"94\"></div>\n            <div class=\"flex items-center gap-4 mb-6\" data-kid=\"95\">\n              <div class=\"w-12 h-12 rounded-xl bg-[#5266EB]/10 border border-[#5266EB]/30 flex items-center justify-center\" data-kid=\"96\">\n                <i class=\"ti ti-rocket text-[#5266EB]\" style=\"fontSize: 24px;\" data-kid=\"97\"></i>\n              </div>\n              <div data-kid=\"98\">\n                <h4 style=\"fontSize: 18px; fontWeight: 600;\" data-kid=\"99\">Sarah Chen</h4>\n                <p class=\"text-[#8A8C99]\" style=\"fontSize: 13px;\" data-kid=\"100\">Product Designer</p>\n              </div>\n            </div>\n            <p class=\"text-[#8A8C99]\" style=\"fontSize: 14px; lineHeight: 1.5;\" data-kid=\"101\">Top 1% candidate in visual interaction nodes.</p>\n          </div>\n       </div>\n    </div>\n  </section>\n\n  \n  <section class=\"h-screen flex items-center justify-center relative bg-black\" data-kid=\"102\">\n    <div class=\"absolute inset-0 bg-radial-at-c from-[#15151E] via-black to-black opacity-80\" data-kid=\"103\"></div>\n    \n    <div class=\"relative z-10 text-center flex flex-col items-center\" data-kid=\"104\">\n      \n      <div class=\"glow-orb w-64 h-64 rounded-full bg-[#5266EB] opacity-20 blur-[100px] absolute\" data-kid=\"105\"></div>\n      <div class=\"w-48 h-48 rounded-full border border-[#5266EB]/50 flex items-center justify-center bg-[#15151E] relative group cursor-pointer overflow-hidden transition-all duration-500 hover:scale-110\" data-kid=\"106\">\n        <div class=\"absolute inset-0 bg-[#5266EB]/10 opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"107\"></div>\n        <div class=\"text-center z-10\" data-kid=\"108\">\n          <i class=\"ti ti-bolt text-[#5266EB] block mb-2\" style=\"fontSize: 32px;\" data-kid=\"109\"></i>\n          <span style=\"font-family: 'Space Grotesk'; fontSize: 16px; fontWeight: 700; letterSpacing: 2px;\" data-kid=\"110\">ENTER <br data-kid=\"111\"> MATRIX</span>\n        </div>\n      </div>\n      \n      <h3 style=\"font-family: 'Space Grotesk'; fontSize: 40px; fontWeight: 700;\" class=\"mt-12\" data-kid=\"112\">READY TO PLUG IN?</h3>\n      <p class=\"text-[#8A8C99] mt-4\" style=\"fontSize: 16px;\" data-kid=\"113\">The network is waiting for your signature.</p>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-12 px-12 border-t border-[#2A2A38] bg-[#15151E] relative z-20\" data-kid=\"114\">\n    <div class=\"flex justify-between items-center\" data-kid=\"115\">\n      <div class=\"flex items-center gap-3\" data-kid=\"116\">\n        <div class=\"w-6 h-6 rounded-full border border-[#5266EB]\" data-kid=\"117\"></div>\n        <span style=\"font-family: 'Space Grotesk'; fontSize: 14px; fontWeight: 500; letterSpacing: 2px;\" data-kid=\"118\">PLACEUP / 2026</span>\n      </div>\n      <div class=\"flex gap-8 text-[#8A8C99]\" style=\"fontSize: 12px; fontWeight: 500;\" data-kid=\"119\">\n        <a href=\"#\" class=\"hover:text-[#FAFAFC] transition-colors\" data-kid=\"120\">PRIVACY_PROTOCOL</a>\n        <a href=\"#\" class=\"hover:text-[#FAFAFC] transition-colors\" data-kid=\"121\">SECURITY_NODE</a>\n        <a href=\"#\" class=\"hover:text-[#FAFAFC] transition-colors\" data-kid=\"122\">LEGAL_MATRIX</a>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script type=\"module\" data-kid=\"123\">\n  import { animate, stagger, scroll, inView } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  // Initial reveal for hero\n  animate(\".stagger-panel\", \n    { opacity: [0, 1], x: [-50, 0] }, \n    { delay: stagger(0.15), duration: 1, ease: \"easeOut\" }\n  );\n\n  // Rotating rings mechanism\n  animate(\".ring-outer\", { rotate: [0, 360] }, { duration: 40, repeat: Infinity, ease: \"linear\" });\n  animate(\".ring-inner\", { rotate: [0, -360] }, { duration: 25, repeat: Infinity, ease: \"linear\" });\n\n  // Isometric cards entry\n  inView(\".isometric-view\", ({ target }) => {\n    animate(target.querySelectorAll(\".iso-card\"), \n      { opacity: [0, 1], y: [100, 0], scale: [0.9, 1] }, \n      { delay: stagger(0.1), duration: 0.8, ease: \"easeOut\" }\n    );\n  });\n\n  // Isometric Hover Interaction\n  document.querySelectorAll('.iso-card').forEach(card => {\n    card.addEventListener('mouseenter', () => {\n      animate(card, { y: -30, scale: 1.05, boxShadow: \"0 20px 40px rgba(82, 102, 235, 0.2)\" }, { duration: 0.4 });\n    });\n    card.addEventListener('mouseleave', () => {\n      animate(card, { y: 0, scale: 1, boxShadow: \"none\" }, { duration: 0.4 });\n    });\n  });\n\n  // CTA Orb Magnetic Effect\n  const orb = document.querySelector('.glow-orb');\n  const container = orb.parentElement;\n  \n  window.addEventListener('mousemove', (e) => {\n    const rect = container.getBoundingClientRect();\n    const centerX = rect.left + rect.width / 2;\n    const centerY = rect.top + rect.height / 2;\n    \n    const distanceX = e.clientX - centerX;\n    const distanceY = e.clientY - centerY;\n    const distance = Math.sqrt(distanceX**2 + distanceY**2);\n    \n    if (distance < 500) {\n      animate(orb, { \n        x: distanceX * 0.15, \n        y: distanceY * 0.15,\n        opacity: [0.2, 0.4]\n      }, { duration: 0.2 });\n    }\n  });\n</script>",
