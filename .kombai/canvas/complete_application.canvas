      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Inter+Tight:wght@900&display=swap');\n\n  :root {\n    --primary: #CCFF00;\n    --forest: #163300;\n    --forest-deep: #0A2B1D;\n    --on-surface: #0E0F0C;\n    --surface: #FFFFFF;\n    --surface-mint: #C6ECDB;\n    --neutral-bg: #F4F4F4;\n    --font-wise: 'Inter Tight', sans-serif;\n    --font-body: 'Inter', sans-serif;\n  }\n\n  body {\n    background-color: var(--surface);\n    color: var(--on-surface);\n    font-family: var(--font-body);\n    margin: 0;\n  }\n\n  .wise-heading {\n    font-family: var(--font-wise);\n    font-weight: 900;\n    text-transform: uppercase;\n    line-height: 0.85;\n    letter-spacing: -0.04em;\n  }\n\n  .clip-corner {\n    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 60px), calc(100% - 60px) 100%, 0 100%);\n    position: relative;\n  }\n\n  .clip-corner::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    padding: 4px; /* Border width */\n    background: var(--primary);\n    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 60px), calc(100% - 60px) 100%, 0 100%);\n    -webkit-mask: \n      linear-gradient(#fff 0 0) content-box, \n      linear-gradient(#fff 0 0);\n    -webkit-mask-composite: xor;\n            mask-composite: exclude;\n    pointer-events: none;\n  }\n\n  .clip-corner-reverse {\n    clip-path: polygon(60px 0, 100% 0, 100% 100%, 0 100%, 0 60px);\n    position: relative;\n  }\n\n  .clip-corner-reverse::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    padding: 4px;\n    background: var(--primary);\n    clip-path: polygon(60px 0, 100% 0, 100% 100%, 0 100%, 0 60px);\n    -webkit-mask: \n      linear-gradient(#fff 0 0) content-box, \n      linear-gradient(#fff 0 0);\n    -webkit-mask-composite: xor;\n            mask-composite: exclude;\n    pointer-events: none;\n  }\n\n  .mask-number {\n    background-size: cover;\n    background-position: center;\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n    font-family: var(--font-wise);\n    font-weight: 900;\n  }\n\n  .brutal-shadow {\n    box-shadow: 10px 10px 0px 0px #000000;\n  }\n\n  .lenis.lenis-smooth {\n    height: auto;\n  }\n\n  .lenis.lenis-smooth [data-lenis-prevent] {\n    overscroll-behavior: contain;\n  }\n\n  .lenis.lenis-stopped {\n    overflow: hidden;\n  }\n\n  .network-line {\n    stroke: var(--primary);\n    stroke-width: 2;\n    fill: none;\n    stroke-dasharray: 1000;\n    stroke-dashoffset: 1000;\n  }\n</style>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"1\">\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"2\">\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"3\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"4\"></script>\n<script type=\"module\" data-kid=\"5\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  const lenis = new Lenis()\n  function raf(time) {\n    lenis.raf(time)\n    requestAnimationFrame(raf)\n  }\n  requestAnimationFrame(raf)\n</script>\n\n<div class=\"overflow-x-clip\" data-kid=\"6\">\n  \n  <nav id=\"main-nav\" class=\"fixed top-0 left-0 w-full z-50 flex justify-between items-center px-6 py-6 md:px-12 mix-blend-difference transition-all duration-300\" data-kid=\"7\">\n    <div class=\"text-white text-3xl font-black tracking-tighter\" data-kid=\"8\">PLACEUP.</div>\n    <div class=\"hidden md:flex gap-12 text-white font-black text-xs uppercase tracking-widest\" data-kid=\"9\">\n      <a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"10\">TRACKER</a>\n      <a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"11\">VISA HUB</a>\n      <a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"12\">PRICING</a>\n    </div>\n    <button class=\"bg-white text-black px-8 py-3 rounded-full font-black text-xs uppercase tracking-widest hover:bg-[var(--primary)] transition-colors cursor-pointer\" data-kid=\"13\">Login</button>\n  </nav>\n\n  \n  <section class=\"relative min-h-screen flex flex-col overflow-hidden py-32 md:py-48\" data-kid=\"14\">\n    \n    <div class=\"absolute inset-0 flex pointer-events-none\" data-kid=\"15\">\n      <div class=\"w-1/2 bg-black\" data-kid=\"16\"></div>\n      <div class=\"w-1/2 bg-[var(--primary)]\" data-kid=\"17\"></div>\n    </div>\n    \n    \n    <div class=\"relative z-10 w-full px-4 md:px-12 flex flex-col items-center justify-center grow\" data-kid=\"18\">\n      <h1 class=\"wise-heading text-[12vw] md:text-[14vw] mix-blend-difference text-white leading-[0.8] tracking-[-0.06em] text-center mb-12\" data-kid=\"19\">\n        GET HIRED.<br data-kid=\"20\">GET SPONSORED.\n      </h1>\n      \n      <div class=\"flex flex-col items-center gap-12 w-full max-w-5xl\" data-kid=\"21\">\n        <p class=\"text-lg md:text-3xl font-black mix-blend-difference text-white uppercase tracking-tighter text-center max-w-4xl leading-tight\" data-kid=\"22\">\n          The ultimate global career accelerator. ATS-crushing resumes, automated visa tracking, and direct sponsorship paths.\n        </p>\n\n        <div class=\"flex flex-col md:flex-row gap-8 w-full justify-center mt-6\" data-kid=\"23\">\n          <button class=\"brutal-shadow bg-black text-[var(--primary)] px-16 py-8 text-3xl font-black uppercase tracking-tight hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-transform duration-200 cursor-pointer\" data-kid=\"24\">\n            Start Matching\n          </button>\n          <button class=\"bg-white text-black border-6 border-black px-16 py-8 text-3xl font-black uppercase tracking-tight hover:bg-black hover:text-white transition-colors duration-200 cursor-pointer\" data-kid=\"25\">\n            Our Visa Hub\n          </button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"features\" class=\"relative py-32 bg-[var(--forest-deep)] overflow-hidden\" data-kid=\"26\">\n    \n    <svg class=\"absolute inset-0 w-full h-full pointer-events-none opacity-80\" preserveAspectRatio=\"none\" data-kid=\"27\">\n      <path id=\"line1\" class=\"network-line\" d=\"M0,200 L400,100 L800,400 L1200,150 L1600,200\" data-kid=\"28\"></path>\n      <path id=\"line2\" class=\"network-line\" d=\"M0,600 L300,450 L700,800 L1200,600 L1800,700\" data-kid=\"29\"></path>\n      <path id=\"line3\" class=\"network-line\" d=\"M200,0 L150,400 L450,850\" data-kid=\"30\"></path>\n      <path id=\"line4\" class=\"network-line\" d=\"M1200,0 L1350,550 L1100,1000\" data-kid=\"31\"></path>\n      <path id=\"line5\" class=\"network-line\" d=\"M500,300 L700,200 L900,400\" data-kid=\"32\"></path>\n      \n      <circle cx=\"400\" cy=\"100\" r=\"4\" fill=\"var(--primary)\" class=\"animate-pulse\" data-kid=\"33\"></circle>\n      <circle cx=\"800\" cy=\"400\" r=\"6\" fill=\"var(--primary)\" class=\"animate-pulse\" data-kid=\"34\"></circle>\n      <circle cx=\"1200\" cy=\"150\" r=\"4\" fill=\"var(--primary)\" class=\"animate-pulse\" data-kid=\"35\"></circle>\n      <circle cx=\"700\" cy=\"800\" r=\"5\" fill=\"var(--primary)\" class=\"animate-pulse\" data-kid=\"36\"></circle>\n      <circle cx=\"1350\" cy=\"550\" r=\"4\" fill=\"var(--primary)\" class=\"animate-pulse\" data-kid=\"37\"></circle>\n    </svg>\n\n    <div class=\"container mx-auto px-6 relative z-10\" data-kid=\"38\">\n      <div class=\"flex flex-col md:flex-row justify-between items-end mb-24 gap-8\" data-kid=\"39\">\n        <h2 class=\"wise-heading text-6xl md:text-8xl text-[var(--primary)] max-w-2xl\" data-kid=\"40\">\n          THE MICROGLIA<br data-kid=\"41\">ENGINE.\n        </h2>\n        <p class=\"text-[var(--primary)] text-xl max-w-md font-black uppercase italic tracking-tighter\" data-kid=\"42\">\n          Proprietary branching network logic that hacks the global job market.\n        </p>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-12 gap-6 h-full\" data-kid=\"43\">\n        \n        <div class=\"md:col-span-8 h-full feature-card group\" data-kid=\"44\">\n          <div class=\"clip-corner bg-black p-12 h-full flex flex-col justify-between transform group-hover:scale-[1.01] transition-transform duration-300\" data-kid=\"45\">\n            <div data-kid=\"46\">\n              <div class=\"w-20 h-20 rounded-full bg-[var(--surface-mint)] flex items-center justify-center mb-8 border-4 border-black\" data-kid=\"47\">\n                <i class=\"ti ti-bolt text-4xl text-[var(--forest)]\" data-kid=\"48\"></i>\n              </div>\n              <h3 class=\"wise-heading text-5xl text-white mb-6\" data-kid=\"49\">ATS SHREDDER 2.0</h3>\n              <p class=\"text-white text-2xl font-bold uppercase tracking-tighter max-w-2xl\" data-kid=\"50\">\n                We don't just optimize resumes. We reconstruct them at the molecular level to ensure 100% visibility for Fortune 500 ATS systems.\n              </p>\n            </div>\n            <div class=\"mt-12 flex gap-4\" data-kid=\"51\">\n              <span class=\"px-4 py-2 bg-[var(--primary)] text-black font-black text-xs uppercase rounded-full\" data-kid=\"52\">Automated</span>\n              <span class=\"px-4 py-2 bg-white/10 text-white font-black text-xs uppercase rounded-full\" data-kid=\"53\">Global Reach</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"md:col-span-4 feature-card group\" data-kid=\"54\">\n          <div class=\"clip-corner-reverse bg-black p-10 h-full flex flex-col transform group-hover:scale-[0.99] transition-transform duration-300\" data-kid=\"55\">\n            <div class=\"w-16 h-16 rounded-full bg-[var(--primary)] flex items-center justify-center mb-8\" data-kid=\"56\">\n              <i class=\"ti ti-shield-check text-3xl text-black\" data-kid=\"57\"></i>\n            </div>\n            <h3 class=\"wise-heading text-3xl text-white mb-4\" data-kid=\"58\">VISA VALIDATOR</h3>\n            <p class=\"text-white/70 font-bold uppercase text-sm tracking-widest leading-relaxed\" data-kid=\"59\">\n              Real-time sponsorship verification. Don't waste seconds applying to companies that won't back your move.\n            </p>\n          </div>\n        </div>\n\n        \n        <div class=\"md:col-span-5 feature-card group\" data-kid=\"60\">\n          <div class=\"clip-corner bg-black p-10 h-full flex flex-col transform group-hover:scale-[0.99] transition-transform duration-300\" data-kid=\"61\">\n            <div class=\"w-16 h-16 rounded-full bg-[var(--surface-mint)] flex items-center justify-center mb-8\" data-kid=\"62\">\n              <i class=\"ti ti-target text-3xl text-black\" data-kid=\"63\"></i>\n            </div>\n            <h3 class=\"wise-heading text-3xl text-white mb-4\" data-kid=\"64\">MATCH MAKER</h3>\n            <p class=\"text-white/70 font-bold uppercase text-sm tracking-widest leading-relaxed\" data-kid=\"65\">\n              AI job mapping that mirrors your skill density against global sponsorship patterns. Pure math, zero bias.\n            </p>\n          </div>\n        </div>\n\n        \n        <div class=\"md:col-span-7 feature-card group\" data-kid=\"66\">\n          <div class=\"clip-corner-reverse bg-[var(--primary)] p-10 h-full flex items-center gap-8 transform group-hover:scale-[1.01] transition-transform duration-300\" data-kid=\"67\">\n            <div class=\"shrink-0\" data-kid=\"68\">\n               <div class=\"w-24 h-24 rounded-full bg-black flex items-center justify-center\" data-kid=\"69\">\n                <i class=\"ti ti-world text-4xl text-[var(--primary)]\" data-kid=\"70\"></i>\n              </div>\n            </div>\n            <div data-kid=\"71\">\n              <h3 class=\"wise-heading text-3xl text-black mb-2\" data-kid=\"72\">45+ COUNTRIES</h3>\n              <p class=\"text-black font-black uppercase text-lg tracking-tighter leading-tight\" data-kid=\"73\">\n                Global coverage from London to Tokyo. Your dream role doesn't have borders, why should you?\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-48 bg-white overflow-hidden\" data-kid=\"74\">\n    <div class=\"container mx-auto px-6\" data-kid=\"75\">\n      <div class=\"flex flex-col lg:flex-row gap-20\" data-kid=\"76\">\n        <div class=\"lg:w-1/2 sticky top-32 h-fit\" data-kid=\"77\">\n          <h2 class=\"wise-heading text-7xl md:text-[120px] text-black mb-8 leading-[0.8]\" data-kid=\"78\">\n            THE<br data-kid=\"79\">THREE<br data-kid=\"80\">STEPS.\n          </h2>\n          <div class=\"h-2 w-32 bg-[var(--primary)] mb-12\" data-kid=\"81\"></div>\n          <p class=\"text-2xl font-black uppercase tracking-tighter text-black/40 max-w-sm\" data-kid=\"82\">\n            Simplified global scaling for your career. From upload to offer.\n          </p>\n        </div>\n\n        <div class=\"lg:w-1/2 space-y-48\" data-kid=\"83\">\n          \n          <div class=\"step-module flex flex-col gap-8\" data-kid=\"84\">\n            <span class=\"mask-number text-[200px] md:text-[300px] block leading-none\" style=\"background-image: url('https://images.pexels.com/photos/12903176/pexels-photo-12903176.jpeg?auto=compress&cs=tinysrgb&w=800&q=80')\" data-kid=\"85\">1</span>\n            <div data-kid=\"86\">\n              <h3 class=\"wise-heading text-5xl text-black mb-6\" data-kid=\"87\">UPLOAD & SCAN</h3>\n              <p class=\"text-xl font-bold uppercase tracking-tighter text-black/60 max-w-md\" data-kid=\"88\">Our AI dissects your profile, identifying gaps in your ATS scores and sponsorship eligibility across 45 countries.</p>\n            </div>\n          </div>\n\n          \n          <div class=\"step-module flex flex-col gap-8\" data-kid=\"89\">\n            <span class=\"mask-number text-[200px] md:text-[300px] block leading-none\" style=\"background-image: url('https://images.unsplash.com/photo-1758518730999-a2aa60205fb1?auto=format&w=800&q=80&fit=crop')\" data-kid=\"90\">2</span>\n            <div data-kid=\"91\">\n              <h3 class=\"wise-heading text-5xl text-black mb-6\" data-kid=\"92\">BRIDGE THE GAP</h3>\n              <p class=\"text-xl font-bold uppercase tracking-tighter text-black/60 max-w-md\" data-kid=\"93\">PlaceUp generates a custom roadmap. We rewrite your bullet points and suggest certifications that actually matter.</p>\n            </div>\n          </div>\n\n          \n          <div class=\"step-module flex flex-col gap-8\" data-kid=\"94\">\n            <span class=\"mask-number text-[200px] md:text-[300px] block leading-none\" style=\"background-image: url('https://images.pexels.com/photos/25651527/pexels-photo-25651527.jpeg?auto=compress&cs=tinysrgb&w=800&q=80')\" data-kid=\"95\">3</span>\n            <div data-kid=\"96\">\n              <h3 class=\"wise-heading text-5xl text-black mb-6\" data-kid=\"97\">AUTO PILOT</h3>\n              <p class=\"text-xl font-bold uppercase tracking-tighter text-black/60 max-w-md\" data-kid=\"98\">Enable Auto-Apply for curated 'High Probability' roles. We track every response and manage your interview calendar.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 bg-[var(--neutral-bg)]\" data-kid=\"99\">\n    <div class=\"container mx-auto px-6\" data-kid=\"100\">\n      <div class=\"text-center mb-24\" data-kid=\"101\">\n        <h2 class=\"wise-heading text-6xl md:text-9xl text-black\" data-kid=\"102\">INVEST IN YOU.</h2>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-12 gap-8 max-w-7xl mx-auto\" data-kid=\"103\">\n        \n        <div class=\"md:col-span-5 bg-white p-12 rounded-[40px] border-6 border-black flex flex-col justify-between group hover:-rotate-1 transition-transform\" data-kid=\"104\">\n          <div data-kid=\"105\">\n            <span class=\"bg-black text-white px-6 py-2 rounded-full text-sm font-black uppercase tracking-widest mb-12 inline-block\" data-kid=\"106\">Free Starter</span>\n            <h3 class=\"wise-heading text-5xl mt-4 mb-4\" data-kid=\"107\">THE SCOUT</h3>\n            <p class=\"text-black text-lg font-bold uppercase tracking-tighter mb-12\" data-kid=\"108\">Perfect for initial global career discovery.</p>\n            <div class=\"space-y-6 mb-12\" data-kid=\"109\">\n              <div class=\"flex items-center gap-4 text-xl font-black italic uppercase\" data-kid=\"110\"><i class=\"ti ti-circle-check text-black\" data-kid=\"111\"></i> 3 Scans</div>\n              <div class=\"flex items-center gap-4 text-xl font-black italic uppercase\" data-kid=\"112\"><i class=\"ti ti-circle-check text-black\" data-kid=\"113\"></i> Database Access</div>\n            </div>\n          </div>\n          <div class=\"mt-auto\" data-kid=\"114\">\n            <div class=\"wise-heading text-8xl mb-8\" data-kid=\"115\">$0</div>\n            <button class=\"w-full py-6 border-6 border-black text-black font-black uppercase text-2xl hover:bg-black hover:text-white transition-colors duration-200 cursor-pointer\" data-kid=\"116\">Start Free</button>\n          </div>\n        </div>\n\n        \n        <div class=\"md:col-span-7 bg-[var(--primary)] p-16 rounded-[40px] border-6 border-black flex flex-col justify-between group hover:rotate-1 transition-transform relative overflow-hidden\" data-kid=\"117\">\n          <div class=\"absolute top-12 right-12 rotate-12 bg-black text-[var(--primary)] px-8 py-2 font-black text-xl uppercase z-20\" data-kid=\"118\">Recommended</div>\n          <div class=\"relative z-10\" data-kid=\"119\">\n            <span class=\"bg-[var(--forest)] text-[var(--primary)] px-6 py-2 rounded-full text-sm font-black uppercase tracking-widest mb-12 inline-block\" data-kid=\"120\">Pro Access</span>\n            <h3 class=\"wise-heading text-7xl mt-4 mb-6\" data-kid=\"121\">THE EXPANDED</h3>\n            <p class=\"text-[var(--forest)] text-2xl font-black uppercase tracking-tighter mb-12 leading-none max-w-md\" data-kid=\"122\">For serious candidates seeking global moves with zero friction.</p>\n            \n            <div class=\"grid grid-cols-2 gap-8 mb-16\" data-kid=\"123\">\n              <div class=\"space-y-6\" data-kid=\"124\">\n                <div class=\"flex items-center gap-4 text-2xl font-black italic uppercase text-[var(--forest)]\" data-kid=\"125\"><i class=\"ti ti-star\" data-kid=\"126\"></i> Unlimited ATS</div>\n                <div class=\"flex items-center gap-4 text-2xl font-black italic uppercase text-[var(--forest)]\" data-kid=\"127\"><i class=\"ti ti-star\" data-kid=\"128\"></i> Path Tracker</div>\n              </div>\n              <div class=\"space-y-6\" data-kid=\"129\">\n                <div class=\"flex items-center gap-4 text-2xl font-black italic uppercase text-[var(--forest)]\" data-kid=\"130\"><i class=\"ti ti-star\" data-kid=\"131\"></i> Auto Pilot</div>\n                <div class=\"flex items-center gap-4 text-2xl font-black italic uppercase text-[var(--forest)]\" data-kid=\"132\"><i class=\"ti ti-star\" data-kid=\"133\"></i> Support</div>\n              </div>\n            </div>\n          </div>\n          <div class=\"mt-auto relative z-10 flex items-center justify-between\" data-kid=\"134\">\n            <div class=\"wise-heading text-[120px] leading-none\" data-kid=\"135\">$15.99</div>\n            <button class=\"py-10 px-12 bg-[var(--forest)] text-[var(--primary)] font-black uppercase text-3xl hover:bg-black transition-colors duration-200 cursor-pointer rounded-full\" data-kid=\"136\">Get Pro</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-48 bg-white\" data-kid=\"137\">\n    <div class=\"container mx-auto px-6\" data-kid=\"138\">\n      <div class=\"max-w-5xl mx-auto flex flex-col md:flex-row gap-20\" data-kid=\"139\">\n        <div class=\"md:w-1/3\" data-kid=\"140\">\n           <h2 class=\"wise-heading text-7xl text-black leading-none mb-8\" data-kid=\"141\">STAY<br data-kid=\"142\">IN THE<br data-kid=\"143\">LOOP.</h2>\n           <p class=\"text-black font-bold uppercase tracking-tighter text-xl\" data-kid=\"144\">Join 50k+ global talent receiving weekly visa-ready opportunities.</p>\n        </div>\n        <div class=\"md:w-2/3\" data-kid=\"145\">\n          <form class=\"space-y-16\" data-kid=\"146\">\n            <div class=\"group\" data-kid=\"147\">\n              <label class=\"block wise-heading text-xl mb-4 text-black\" data-kid=\"148\">Full Name</label>\n              <input type=\"text\" placeholder=\"Enter your name\" class=\"w-full text-2xl md:text-4xl font-bold border-b-6 border-black pb-6 outline-hidden focus:border-[var(--primary)] transition-colors\" data-kid=\"149\">\n            </div>\n            <div class=\"group\" data-kid=\"150\">\n              <label class=\"block wise-heading text-xl mb-4 text-black\" data-kid=\"151\">Work Email</label>\n              <input type=\"email\" placeholder=\"your@email.com\" class=\"w-full text-2xl md:text-4xl font-bold border-b-6 border-black pb-6 outline-hidden focus:border-[var(--primary)] transition-colors\" data-kid=\"152\">\n            </div>\n            <button type=\"button\" class=\"w-full bg-[var(--primary)] border-6 border-black brutal-shadow py-12 wise-heading text-5xl text-black hover:translate-x-1 hover:translate-y-1 hover:shadow-none cursor-pointer\" data-kid=\"153\">\n              SUBMIT\n            </button>\n          </form>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"bg-black py-20\" data-kid=\"154\">\n    <div class=\"container mx-auto px-6\" data-kid=\"155\">\n      <div class=\"grid grid-cols-2 md:grid-cols-4 gap-12 mb-20\" data-kid=\"156\">\n        <div data-kid=\"157\">\n          <h4 class=\"text-[var(--primary)] wise-heading text-lg mb-8\" data-kid=\"158\">PRODUCT</h4>\n          <ul class=\"space-y-4 text-white/50 font-bold uppercase text-sm\" data-kid=\"159\">\n            <li data-kid=\"160\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"161\">Resume Builder</a></li>\n            <li data-kid=\"162\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"163\">Visa Database</a></li>\n            <li data-kid=\"164\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"165\">Auto Apply</a></li>\n          </ul>\n        </div>\n        <div data-kid=\"166\">\n          <h4 class=\"text-[var(--primary)] wise-heading text-lg mb-8\" data-kid=\"167\">COMPANY</h4>\n          <ul class=\"space-y-4 text-white/50 font-bold uppercase text-sm\" data-kid=\"168\">\n            <li data-kid=\"169\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"170\">About Us</a></li>\n            <li data-kid=\"171\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"172\">Success Stories</a></li>\n            <li data-kid=\"173\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"174\">Careers</a></li>\n          </ul>\n        </div>\n        <div data-kid=\"175\">\n          <h4 class=\"text-[var(--primary)] wise-heading text-lg mb-8\" data-kid=\"176\">LEGAL</h4>\n          <ul class=\"space-y-4 text-white/50 font-bold uppercase text-sm\" data-kid=\"177\">\n            <li data-kid=\"178\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"179\">Privacy</a></li>\n            <li data-kid=\"180\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"181\">Terms</a></li>\n            <li data-kid=\"182\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"183\">Cookie Policy</a></li>\n          </ul>\n        </div>\n        <div class=\"col-span-2 md:col-span-1\" data-kid=\"184\">\n          <h4 class=\"text-[var(--primary)] wise-heading text-lg mb-8\" data-kid=\"185\">FOLLOW</h4>\n          <div class=\"flex gap-6\" data-kid=\"186\">\n            <a href=\"#\" class=\"w-12 h-12 rounded-full border border-white/20 flex items-center justify-center text-white hover:bg-[var(--primary)] hover:text-black transition-all\" data-kid=\"187\">\n              <i class=\"ti ti-brand-twitter\" data-kid=\"188\"></i>\n            </a>\n            <a href=\"#\" class=\"w-12 h-12 rounded-full border border-white/20 flex items-center justify-center text-white hover:bg-[var(--primary)] hover:text-black transition-all\" data-kid=\"189\">\n              <i class=\"ti ti-brand-linkedin\" data-kid=\"190\"></i>\n            </a>\n            <a href=\"#\" class=\"w-12 h-12 rounded-full border border-white/20 flex items-center justify-center text-white hover:bg-[var(--primary)] hover:text-black transition-all\" data-kid=\"191\">\n              <i class=\"ti ti-brand-instagram\" data-kid=\"192\"></i>\n            </a>\n          </div>\n        </div>\n      </div>\n      <div class=\"pt-20 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"193\">\n        <div class=\"wise-heading text-4xl text-[var(--primary)]\" data-kid=\"194\">PLACEUP.</div>\n        <p class=\"text-white/30 text-xs font-bold uppercase tracking-widest\" data-kid=\"195\">&copy; 2026 PLACEUP GLOBAL INC. ALL RIGHTS RESERVED.</p>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script data-kid=\"196\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  window.addEventListener('DOMContentLoaded', () => {\n    // Animate lines in Features section\n    const lines = document.querySelectorAll('.network-line');\n    lines.forEach((line) => {\n      gsap.to(line, {\n        strokeDashoffset: 0,\n        scrollTrigger: {\n          trigger: '#features',\n          start: 'top center',\n          end: 'bottom center',\n          scrub: 1,\n        }\n      });\n    });\n\n    // Hero Text Animation\n    gsap.from('.wise-heading', {\n      y: 100,\n      opacity: 0,\n      duration: 1.2,\n      stagger: 0.1,\n      ease: 'expo.out'\n    });\n\n    // Nav Scroll Effect\n    ScrollTrigger.create({\n      start: 'top -80',\n      onEnter: () => gsap.to('#main-nav', { padding: '1.5rem 3rem', backgroundColor: 'rgba(0,0,0,0.4)', backdropFilter: 'blur(10px)', mixBlendMode: 'normal' }),\n      onLeaveBack: () => gsap.to('#main-nav', { padding: '2rem 3rem', backgroundColor: 'transparent', backdropFilter: 'blur(0px)', mixBlendMode: 'difference' })\n    });\n\n    // Masked Numbers Parallax\n    gsap.utils.toArray('.mask-number').forEach(number => {\n      gsap.fromTo(number, \n        { backgroundPositionY: '0%' },\n        { \n          backgroundPositionY: '100%',\n          scrollTrigger: {\n            trigger: number,\n            start: 'top bottom',\n            end: 'bottom top',\n            scrub: true\n          }\n        }\n      );\n    });\n\n    // Feature Cards Entrance\n    gsap.from('.feature-card', {\n      y: 60,\n      opacity: 0,\n      stagger: 0.2,\n      scrollTrigger: {\n        trigger: '#features',\n        start: 'top 70%'\n      }\n    });\n  });\n</script>\n",
