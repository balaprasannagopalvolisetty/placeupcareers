      "html": "<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"0\">\n<style data-kid=\"1\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;400;500;600;700&display=swap');\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap');\n\n  body {\n    background-color: #020617;\n    color: #FAFAFC;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-sans { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-heading { font-family: 'Space Grotesk', sans-serif; }\n\n  .glass-resin {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(24px);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    box-shadow: inset 0 0 30px rgba(255, 255, 255, 0.02);\n  }\n\n  .mercury-text {\n    background: linear-gradient(135deg, #C9A99A, #B7B6CE, #7E8A9E);\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n  }\n\n  .glow-periwinkle {\n    box-shadow: 0 0 50px rgba(99, 102, 241, 0.2);\n  }\n\n  .network-line {\n    stroke: #6366F1;\n    stroke-opacity: 0.15;\n    stroke-width: 1;\n  }\n\n  .3d-btn {\n    background: linear-gradient(135deg, #7E8A9E 0%, #B7B6CE 50%, #C9A99A 100%);\n    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), inset 0 2px 5px rgba(255, 255, 255, 0.4);\n    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);\n  }\n\n  .topography-grid {\n    background-image: radial-gradient(circle at 2px 2px, rgba(99, 102, 241, 0.05) 1px, transparent 0);\n    background-size: 40px 40px;\n  }\n</style>\n\n<div class=\"relative min-h-screen font-sans overflow-hidden\" data-kid=\"2\">\n  \n  <div id=\"hero-network\" class=\"absolute inset-0 z-0 opacity-40\" data-kid=\"3\">\n    <svg width=\"100%\" height=\"100%\" class=\"absolute inset-0\" data-kid=\"4\">\n      <g id=\"network-group\" data-kid=\"5\"></g>\n    </svg>\n  </div>\n\n  \n  <div class=\"absolute inset-0 flex items-center justify-center z-0 select-none pointer-events-none\" data-kid=\"6\">\n    <h1 style=\"font-size: 400px; font-weight: 700; opacity: 0.02; letter-spacing: -0.05em;\" class=\"font-heading\" data-kid=\"7\">GRID</h1>\n  </div>\n\n  \n  <section class=\"relative z-10 min-h-screen flex flex-col items-center justify-center px-6\" data-kid=\"8\">\n    <div class=\"max-w-4xl w-full text-center\" data-kid=\"9\">\n      <div class=\"inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/10 bg-white/5 backdrop-blur-md mb-8\" data-kid=\"10\">\n        <span class=\"w-2 h-2 rounded-full bg-[#6366F1] animate-pulse\" data-kid=\"11\"></span>\n        <span style=\"font-size: 13px; font-weight: 500; letter-spacing: 0.05em; color: #8A8C99;\" data-kid=\"12\">V.3 RESINATE PROTOCOL</span>\n      </div>\n      \n      <h2 style=\"font-size: clamp(48px, 8vw, 100px); font-weight: 700; line-height: 0.95; letter-spacing: -0.04em;\" class=\"font-heading mb-8\" data-kid=\"13\">\n        Shape Your <span class=\"mercury-text\" data-kid=\"14\">Future</span> <br data-kid=\"15\"> in the Matrix\n      </h2>\n\n      \n      <div class=\"max-w-2xl mx-auto relative group\" data-kid=\"16\">\n        <div class=\"absolute -inset-1 bg-gradient-to-r from-[#6366F1] to-transparent rounded-full blur opacity-20 group-hover:opacity-40 transition duration-1000\" data-kid=\"17\"></div>\n        <div class=\"relative glass-resin rounded-full p-2 flex items-center gap-4\" data-kid=\"18\">\n          <div class=\"pl-6 text-[#8A8C99]\" data-kid=\"19\">\n            <i class=\"ti ti-search text-xl\" data-kid=\"20\"></i>\n          </div>\n          <input type=\"text\" placeholder=\"Find your node in the network...\" class=\"w-full bg-transparent border-none outline-hidden py-4 text-lg placeholder:text-white/20\" data-kid=\"21\">\n          <button class=\"bg-[#6366F1] hover:bg-[#5266EB] text-white px-8 py-4 rounded-full transition-all duration-300\" data-kid=\"22\">\n            <span style=\"font-size: 15px; font-weight: 600;\" data-kid=\"23\">Initialize</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"relative z-10 py-32 topography-grid\" data-kid=\"24\">\n    <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"25\">\n      <div class=\"grid lg:grid-cols-2 gap-20 items-center\" data-kid=\"26\">\n        <div class=\"relative h-[600px] flex items-center justify-center\" data-kid=\"27\">\n          \n          <svg viewBox=\"0 0 500 500\" class=\"absolute inset-0 w-full h-full\" data-kid=\"28\">\n            <path d=\"M50,400 Q150,350 250,380 T450,300\" fill=\"none\" stroke=\"#6366F1\" stroke-width=\"2\" class=\"opacity-20\" data-kid=\"29\"></path>\n            <path d=\"M50,420 Q150,370 250,400 T450,320\" fill=\"none\" stroke=\"#6366F1\" stroke-width=\"1\" class=\"opacity-10\" data-kid=\"30\"></path>\n            \n            <circle cx=\"250\" cy=\"380\" r=\"4\" fill=\"#6366F1\" data-kid=\"31\"></circle>\n            <line x1=\"250\" y1=\"380\" x2=\"250\" y2=\"150\" stroke=\"#7E8A9E\" stroke-width=\"1\" stroke-dasharray=\"4\" data-kid=\"32\"></line>\n          </svg>\n          \n          \n          <div class=\"relative z-20 group\" data-kid=\"33\">\n            <img src=\"https://images.unsplash.com/photo-1754307159643-1699d0151ed1?auto=format&w=800&q=80&fit=crop\" alt=\"Metallic Chess Piece\" class=\"w-64 h-80 object-contain drop-shadow-2xl transform transition-transform group-hover:scale-110\" loading=\"lazy\" decoding=\"async\" data-kid=\"34\">\n            <div class=\"absolute -bottom-10 left-1/2 -translate-x-1/2 glass-resin p-6 rounded-2xl w-64\" data-kid=\"35\">\n              <div class=\"flex items-center gap-3 mb-2\" data-kid=\"36\">\n                <i class=\"ti ti-trending-up text-[#06B6D4]\" data-kid=\"37\"></i>\n                <span style=\"font-size: 14px; font-weight: 600; color: #06B6D4;\" data-kid=\"38\">+42% GROWTH</span>\n              </div>\n              <p style=\"font-size: 13px; color: #8A8C99;\" data-kid=\"39\">Strategic trajectory mapped for Executive Cloud Architecture.</p>\n            </div>\n          </div>\n        </div>\n\n        <div data-kid=\"40\">\n          <h3 style=\"font-size: 40px; font-weight: 700; line-height: 1.1;\" class=\"font-heading mb-6\" data-kid=\"41\">\n            Growth <span class=\"mercury-text\" data-kid=\"42\">Trajectories</span> <br data-kid=\"43\"> solidified in Resin.\n          </h3>\n          <p style=\"font-size: 18px; line-height: 1.6; color: #C4C6D0;\" class=\"mb-10 max-w-md\" data-kid=\"44\">\n            Our Simplex engine transforms junior trajectories into executive nodes. Every step is a calculated move on the global network.\n          </p>\n          \n          <div class=\"space-y-4\" data-kid=\"45\">\n            <div class=\"glass-resin p-6 rounded-2xl flex items-center gap-4 hover:bg-white/5 transition-colors\" data-kid=\"46\">\n              <div class=\"w-12 h-12 rounded-xl bg-[#6366F1]/10 flex items-center justify-center text-[#6366F1]\" data-kid=\"47\">\n                <i class=\"ti ti-chart-dots text-2xl\" data-kid=\"48\"></i>\n              </div>\n              <div data-kid=\"49\">\n                <h4 style=\"font-size: 16px; font-weight: 600;\" data-kid=\"50\">Chartism Mapping</h4>\n                <p style=\"font-size: 14px; color: #8A8C99;\" data-kid=\"51\">High-fidelity data visualization for your career path.</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"relative z-10 py-32 bg-white/2\" data-kid=\"52\">\n    <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"53\">\n      <div class=\"text-center mb-20\" data-kid=\"54\">\n        <h3 style=\"font-size: 40px; font-weight: 700;\" class=\"font-heading mb-4\" data-kid=\"55\">Ventral Hub</h3>\n        <p style=\"font-size: 16px; color: #8A8C99;\" data-kid=\"56\">Your command center in the network.</p>\n      </div>\n\n      <div class=\"grid md:grid-cols-3 gap-8\" data-kid=\"57\">\n        \n        <div class=\"glass-resin rounded-[20px] overflow-hidden group\" data-kid=\"58\">\n          <div class=\"h-48 relative overflow-hidden\" data-kid=\"59\">\n            <img src=\"https://images.pexels.com/photos/12833267/pexels-photo-12833267.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" loading=\"lazy\" decoding=\"async\" data-kid=\"60\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-[#020617] to-transparent\" data-kid=\"61\"></div>\n          </div>\n          <div class=\"p-8\" data-kid=\"62\">\n            <div class=\"flex justify-between items-center mb-6\" data-kid=\"63\">\n              <span style=\"font-size: 12px; font-weight: 700; color: #6366F1; letter-spacing: 0.1em;\" data-kid=\"64\">NODE AUTHENTICATED</span>\n              <i class=\"ti ti-lock-open text-white/40\" data-kid=\"65\"></i>\n            </div>\n            <h4 style=\"font-size: 20px; font-weight: 600;\" class=\"mb-2\" data-kid=\"66\">Matrix Match #402</h4>\n            <p style=\"font-size: 14px; color: #8A8C99; line-height: 1.5;\" data-kid=\"67\">Polished resin surface over liquid metal matching algorithms.</p>\n          </div>\n        </div>\n\n        \n        <div class=\"glass-resin rounded-[20px] p-8 flex flex-col justify-center items-center text-center\" data-kid=\"68\">\n            <div class=\"w-16 h-16 rounded-full bg-[#6366F1]/20 flex items-center justify-center mb-6 border border-[#6366F1]/30\" data-kid=\"69\">\n                <i class=\"ti ti-trending-up text-3xl text-[#6366F1]\" data-kid=\"70\"></i>\n            </div>\n            <h4 style=\"font-size: 20px; font-weight: 600;\" class=\"mb-2\" data-kid=\"71\">Real-time Pulse</h4>\n            <p style=\"font-size: 14px; color: #8A8C99;\" data-kid=\"72\">Monitoring node health and market trends across 32 countries.</p>\n        </div>\n\n        <div class=\"glass-resin rounded-[20px] p-8 bg-gradient-to-br from-[#6366F1]/5 to-transparent border-[#6366F1]/20\" data-kid=\"73\">\n            <div class=\"flex gap-1 mb-8\" data-kid=\"74\">\n                <div class=\"h-1 w-8 rounded-full bg-[#6366F1]\" data-kid=\"75\"></div>\n                <div class=\"h-1 w-8 rounded-full bg-white/10\" data-kid=\"76\"></div>\n                <div class=\"h-1 w-8 rounded-full bg-white/10\" data-kid=\"77\"></div>\n            </div>\n            <h4 style=\"font-size: 24px; font-weight: 700;\" class=\"font-heading mb-4\" data-kid=\"78\">Master Your <span class=\"mercury-text\" data-kid=\"79\">Simplex</span></h4>\n            <p style=\"font-size: 14px; color: #8A8C99; margin-bottom: 24px;\" data-kid=\"80\">Connect your profile to the grid to start the resonance protocol.</p>\n            <button class=\"w-full py-4 rounded-xl border border-white/10 hover:bg-white/5 transition-all text-sm font-semibold\" data-kid=\"81\">\n                Explore Dashboard\n            </button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"relative z-10 py-64 flex flex-col items-center justify-center overflow-hidden\" data-kid=\"82\">\n    \n    <svg class=\"absolute inset-0 w-full h-full pointer-events-none opacity-20\" data-kid=\"83\">\n      <path d=\"M0,0 L720,500\" class=\"network-line\" data-kid=\"84\"></path>\n      <path d=\"M1440,0 L720,500\" class=\"network-line\" data-kid=\"85\"></path>\n      <path d=\"M0,1000 L720,500\" class=\"network-line\" data-kid=\"86\"></path>\n      <path d=\"M1440,1000 L720,500\" class=\"network-line\" data-kid=\"87\"></path>\n      <circle cx=\"720\" cy=\"500\" r=\"100\" fill=\"url(#grad1)\" class=\"opacity-10\" data-kid=\"88\"></circle>\n      <defs data-kid=\"89\">\n        <radialGradient id=\"grad1\" cx=\"50%\" cy=\"50%\" r=\"50%\" fx=\"50%\" fy=\"50%\" data-kid=\"90\">\n          <stop offset=\"0%\" style=\"stop-color:#6366F1;stop-opacity:1\" data-kid=\"91\"></stop>\n          <stop offset=\"100%\" style=\"stop-color:#020617;stop-opacity:0\" data-kid=\"92\"></stop>\n        </radialGradient>\n      </defs>\n    </svg>\n\n    <div class=\"relative z-20 text-center\" data-kid=\"93\">\n      <h3 style=\"font-size: clamp(32px, 5vw, 64px); font-weight: 700;\" class=\"font-heading mb-12\" data-kid=\"94\">\n        Initialize the <span class=\"mercury-text\" data-kid=\"95\">Simplex Point</span>\n      </h3>\n      \n      <button class=\"3d-btn px-16 py-8 rounded-full relative group\" data-kid=\"96\">\n        <div class=\"absolute inset-0 rounded-full bg-[#6366F1]/40 blur-xl opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"97\"></div>\n        <span style=\"font-size: 24px; font-weight: 700; color: #020617;\" class=\"relative z-10 flex items-center gap-3\" data-kid=\"98\">\n          Connect to the Grid\n          <span class=\"animate-pulse\" data-kid=\"99\">⚡</span>\n        </span>\n      </button>\n    </div>\n  </section>\n\n  \n  <footer class=\"relative z-10 py-20 border-t border-white/5 bg-black/20\" data-kid=\"100\">\n    <div class=\"max-w-7xl mx-auto px-6 grid md:grid-cols-4 gap-12\" data-kid=\"101\">\n      <div class=\"col-span-1\" data-kid=\"102\">\n        <div style=\"font-size: 20px; font-weight: 700; letter-spacing: 0.2em;\" class=\"font-heading mb-6\" data-kid=\"103\">\n          P L A C E U P\n        </div>\n        <p style=\"font-size: 14px; color: #8A8C99;\" data-kid=\"104\">The future of career placements, solidified in resin and mapped in 3D.</p>\n      </div>\n      <div data-kid=\"105\">\n        <h5 style=\"font-size: 12px; font-weight: 700; color: #8A8C99; letter-spacing: 0.1em;\" class=\"mb-6\" data-kid=\"106\">PROTOCOL</h5>\n        <ul class=\"space-y-4\" style=\"font-size: 14px;\" data-kid=\"107\">\n          <li data-kid=\"108\"><a href=\"#\" class=\"hover:text-[#6366F1] transition\" data-kid=\"109\">Resinate Matching</a></li>\n          <li data-kid=\"110\"><a href=\"#\" class=\"hover:text-[#6366F1] transition\" data-kid=\"111\">Chartism Analysis</a></li>\n          <li data-kid=\"112\"><a href=\"#\" class=\"hover:text-[#6366F1] transition\" data-kid=\"113\">Simplex Engine</a></li>\n        </ul>\n      </div>\n      <div data-kid=\"114\">\n        <h5 style=\"font-size: 12px; font-weight: 700; color: #8A8C99; letter-spacing: 0.1em;\" class=\"mb-6\" data-kid=\"115\">CONNECT</h5>\n        <ul class=\"space-y-4\" style=\"font-size: 14px;\" data-kid=\"116\">\n          <li data-kid=\"117\"><a href=\"#\" class=\"hover:text-[#6366F1] transition\" data-kid=\"118\">Discord Matrix</a></li>\n          <li data-kid=\"119\"><a href=\"#\" class=\"hover:text-[#6366F1] transition\" data-kid=\"120\">GitHub Repository</a></li>\n          <li data-kid=\"121\"><a href=\"#\" class=\"hover:text-[#6366F1] transition\" data-kid=\"122\">Twitter / X</a></li>\n        </ul>\n      </div>\n      <div data-kid=\"123\">\n        <div class=\"glass-resin p-6 rounded-2xl\" data-kid=\"124\">\n          <p style=\"font-size: 13px; font-weight: 500;\" class=\"mb-4\" data-kid=\"125\">SYSTEM STATUS: OPTIMAL</p>\n          <div class=\"h-1 w-full bg-white/5 rounded-full overflow-hidden\" data-kid=\"126\">\n            <div class=\"h-full bg-[#6366F1] w-[98%]\" data-kid=\"127\"></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"128\"></script>\n<script data-kid=\"129\">\n  // Initialize Network Visuals\n  const group = document.getElementById('network-group');\n  const points = [];\n  const numPoints = 20;\n\n  for (let i = 0; i < numPoints; i++) {\n    const x = Math.random() * window.innerWidth;\n    const y = Math.random() * window.innerHeight;\n    points.push({ x, y, ox: x, oy: y });\n    \n    const circle = document.createElementNS(\"http://www.w3.org/2000/svg\", \"circle\");\n    circle.setAttribute(\"cx\", x);\n    circle.setAttribute(\"cy\", y);\n    circle.setAttribute(\"r\", \"2\");\n    circle.setAttribute(\"fill\", \"#6366F1\");\n    circle.setAttribute(\"class\", \"parallax-node\");\n    group.appendChild(circle);\n  }\n\n  // Mouse Parallax for Hero\n  window.addEventListener('mousemove', (e) => {\n    const mouseX = e.clientX;\n    const mouseY = e.clientY;\n    \n    const centerX = window.innerWidth / 2;\n    const centerY = window.innerHeight / 2;\n    \n    const moveX = (mouseX - centerX) / 50;\n    const moveY = (mouseY - centerY) / 50;\n    \n    gsap.to('#network-group', {\n      x: moveX,\n      y: moveY,\n      duration: 1,\n      ease: 'power2.out'\n    });\n\n    gsap.to('.mercury-text', {\n        skewX: moveX / 5,\n        duration: 2,\n        ease: 'power1.out'\n    });\n  });\n\n  // Entrance Animations\n  gsap.from('h2', {\n    y: 100,\n    opacity: 0,\n    duration: 1.5,\n    ease: 'power4.out',\n    delay: 0.5\n  });\n\n  gsap.from('.glass-resin', {\n    scale: 0.9,\n    opacity: 0,\n    duration: 1.2,\n    stagger: 0.1,\n    ease: 'back.out(1.7)',\n    delay: 1\n  });\n</script>",
