# PlaceUp Career Backend — environment template
# Copy to .env and fill in real secrets in production.

# Server
APP_ENV=production
APP_PORT=8080
FRONTEND_URL=https://placeupcareer.com
FREE_ACCESS_ENABLED=true

# Auth — REQUIRED in production. Use `openssl rand -hex 32` to generate.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=30
INTERNAL_API_KEY=
ADMIN_EMAILS=operations@placeupcareer.com
SIGNUP_REQUIRE_PAYMENT=false

# OAuth2 / OIDC - Google SSO
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_GOOGLE_REDIRECT_URI=

# --- Server topology (see HYBRID_ARCHITECTURE.md) ---
# web = public API (verified users, behind Cloudflare)
# app = internal application server (32-country pipelines; service-token only)
SERVER_ROLE=web
# Base URL of the internal app server, set ONLY on the web service.
APP_SERVER_URL=
# HMAC key for service-to-service tokens. Same value on BOTH services.
# Generate: openssl rand -hex 32
SERVICE_TOKEN_SECRET=

# Database - Supabase Postgres for jobs, Firestore for users (hybrid)
# Percent-encode special characters in the password.
# Deployed services (Cloud Run is IPv4): use the SESSION POOLER host from
#   Supabase dashboard -> Connect (aws-x-<region>.pooler.supabase.com:5432).
# One-off imports from your machine can use the direct host shown below.
DATABASE_BACKEND=postgres
DATABASE_URL=postgresql+psycopg://postgres.dyeuehtkdatqftdydgvc:URL_ENCODED_PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
# NOTE: supabase-js keys (publishable/secret) are NOT used anywhere in this
# stack. The backend talks straight Postgres; the frontend must never talk
# to Supabase directly (Data API is disabled). If a sb_secret_* key was ever
# exposed, rotate it in Supabase -> Settings -> API Keys.
FIREBASE_CREDENTIALS_PATH=./service-account.json
GCP_PROJECT_ID=steel-shine-492401-u6
USER_DATABASE_BACKEND=firestore
USER_FIRESTORE_PROJECT_ID=placeup-firebase-641222668282
USER_FIRESTORE_DATABASE=(default)

# LLM
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# OpenRouter-backed ScrapeGraphAI discovery
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://placeupcareer.com

# Job scraping APIs
RAPIDAPI_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
GREENHOUSE_BOARD_TOKENS=

# Contact enrichment
APOLLO_API_KEY=
HUNTER_API_KEY=
SERPAPI_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
FINALSCOUT_API_KEY=
FINALSCOUT_API_KEYS=

# Hosted payment links. Card data must go directly to the processor.
PAYMENT_BASIC_CHECKOUT_URL=
PAYMENT_PRO_CHECKOUT_URL=
PAYMENT_ELITE_CHECKOUT_URL=

# Contact form delivery
CONTACT_RECIPIENT_EMAIL=operations@placeupcareer.com

# Scraping
SCRAPE_INTERVAL_HOURS=6
SCRAPE_MAX_CONCURRENCY=28
SCRAPEGRAPH_DISCOVERY_ENABLED=false
SCRAPEGRAPH_DISCOVERY_MAX_URLS=220
SCRAPEGRAPH_DISCOVERY_CONCURRENCY=3
SCRAPEGRAPH_CAREER_PAGES=
PROXY_URL=

# Optional
REDIS_URL=

# --- Invite gate (private beta) ---
# Gate sign-in/sign-up behind an invite code. Set to false at public launch.
INVITE_GATE_ENABLED=true
# Rotate the code anytime without a deploy — it lives only on the server.
INVITE_CODE=
INVITE_TOKEN_TTL_MINUTES=60

# --- Cloudflare origin lock ---
# Random 32+ char secret. A Cloudflare Transform Rule stamps it on every
# proxied request (header X-CF-Origin-Secret); the API rejects requests
# without it, so nobody can bypass Cloudflare and hit Cloud Run directly.
# Leave empty until the Cloudflare rule is live, then set BOTH places.
CF_ORIGIN_SECRET=
