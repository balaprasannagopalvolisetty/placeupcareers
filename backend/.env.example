# PlaceUp Career Backend — environment template
# Copy to .env and fill in real secrets in production.

# Server
APP_ENV=production
APP_PORT=8080
FRONTEND_URL=https://placeup-frontend-76tybrmgya-ue.a.run.app

# Auth — REQUIRED in production. Use `openssl rand -hex 32` to generate.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=30
INTERNAL_API_KEY=

# OAuth2 / OIDC - Google SSO
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_GOOGLE_REDIRECT_URI=

# Database - Cloud SQL Postgres for jobs, Firestore for users
DATABASE_BACKEND=postgres
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@/DATABASE?host=/cloudsql/PROJECT_ID:us-east1:placeup-backend
FIREBASE_CREDENTIALS_PATH=./service-account.json
GCP_PROJECT_ID=steel-shine-492401-u6
USER_DATABASE_BACKEND=firestore
USER_FIRESTORE_PROJECT_ID=placeup-firebase-641222668282
USER_FIRESTORE_DATABASE=(default)

# LLM
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Job scraping APIs
RAPIDAPI_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
GREENHOUSE_BOARD_TOKENS=

# Contact enrichment
APOLLO_API_KEY=
HUNTER_API_KEY=
SERPAPI_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
FINALSCOUT_API_KEY=

# Scraping
SCRAPE_INTERVAL_HOURS=6
SCRAPE_MAX_CONCURRENCY=28
PROXY_URL=

# Optional
REDIS_URL=
