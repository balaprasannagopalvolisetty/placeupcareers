# PlaceUp Career Backend — environment template
# Copy to .env and fill in real secrets in production.

# Server
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# Auth — REQUIRED in production. Use `openssl rand -hex 32` to generate.
JWT_SECRET=dev-only-change-me-jwt-secret-key-32-chars-min
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080  # 7 days

# Database — sqlite (default, file-based) or firestore
DATABASE_BACKEND=sqlite
FIREBASE_CREDENTIALS_PATH=./service-account.json
GCP_PROJECT_ID=

# LLM
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Job scraping APIs
RAPIDAPI_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
GREENHOUSE_BOARD_TOKENS=

# Contact enrichment
APOLLO_API_KEY=
HUNTER_API_KEY=
SERPAPI_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
FINALSCOUT_API_KEY=c7c56edb8e2d45daf5c9112038eba16e

# Scraping
SCRAPE_INTERVAL_HOURS=2
SCRAPE_MAX_CONCURRENCY=28
PROXY_URL=

# Optional
REDIS_URL=
