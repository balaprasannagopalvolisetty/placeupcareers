# Frontend dev defaults — copy to .env.local to override.
#
# When VITE_API_BASE is empty, requests use relative paths and are
# forwarded to the backend through the Vite dev proxy configured in
# vite.config.ts (target: http://localhost:8000).
#
# Set this only if you want to bypass the proxy or point at a deployed
# backend, e.g. VITE_API_BASE=https://api.placeupcareer.com
VITE_API_BASE=
